---
// src/components/ui/CocktailModal.astro
---

<div id="cocktail-modal" class="fixed inset-0 z-[9999] opacity-0 pointer-events-none transition-all duration-500 backdrop-blur-3xl bg-[#020617]/80 flex items-center justify-center p-4 md:p-8">
  <!-- Modal Content Container -->
  <div class="relative w-full max-w-5xl h-[90vh] md:h-[80vh] flex flex-col md:flex-row bg-[#020617]/50 rounded-[2rem] border-2 border-neon-blue/40 md:border-neon-pink/40 overflow-hidden shadow-[0_0_50px_rgba(56,189,248,0.2)] md:shadow-[0_0_80px_rgba(208,82,255,0.2)] transform scale-95 transition-transform duration-500 group-modal">
    
    <!-- Close button -->
    <button id="close-modal-btn" class="absolute top-6 right-6 z-50 text-white/50 hover:text-white hover:rotate-90 transition-all duration-300 bg-[#020617]/50 rounded-full p-2 backdrop-blur-md">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    
    <!-- Image Section -->
    <div class="w-full md:w-2/5 h-1/3 md:h-full bg-gradient-to-br from-[#11021b]/60 to-[#020617] relative flex items-center justify-center border-b md:border-b-0 md:border-r border-white/10 p-6 overflow-hidden">
        <div class="absolute inset-0 bg-neon-pink/15 blur-[100px] z-0"></div>
        <div class="absolute inset-0 bg-[url('/noise.svg')] opacity-5 mix-blend-overlay"></div>
        <img id="cm-image" src="" alt="" referrerpolicy="no-referrer" class="max-h-full max-w-full object-contain relative z-10 drop-shadow-[0_0_40px_rgba(56,189,248,0.4)]" />
    </div>

    <!-- Content Section -->
    <div class="w-full md:w-3/5 h-2/3 md:h-full overflow-y-auto p-6 md:p-12 hide-scrollbar flex flex-col bg-[#020617]/30">
        <h3 class="text-neon-pink/90 font-black text-[10px] md:text-xs tracking-[0.4em] uppercase mb-3">El Cóctel Perfecto</h3>
        <h2 id="cm-name" class="font-['Bebas_Neue'] text-6xl md:text-7xl text-white tracking-widest mb-10 uppercase leading-none drop-shadow-[0_0_15px_rgba(56,189,248,0.5)]"></h2>

        <div class="space-y-10">
            <!-- Ingredients -->
            <div>
                <h4 class="text-neon-blue font-black text-[10px] md:text-xs tracking-[0.2em] uppercase mb-5 border-b border-white/10 pb-3 flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 16v1a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3v-1m-4-8-4-4-4 4m4-4v12"/></svg>
                    Ingredientes Requeridos
                </h4>
                <ul id="cm-ingredients" class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm text-slate-300">
                    <!-- JS populated -->
                </ul>
            </div>

            <!-- Instructions -->
            <div>
                <h4 class="text-neon-blue font-black text-[10px] md:text-xs tracking-[0.2em] uppercase mb-5 border-b border-white/10 pb-3 flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    Cómo Servirlo Como Un Maestro
                </h4>
                <ol id="cm-instructions" class="space-y-4 list-decimal list-inside text-sm text-slate-300 marker:text-neon-pink marker:font-black leading-relaxed">
                    <!-- JS populated -->
                </ol>
            </div>

            <!-- History -->
            <div class="pb-10">
                <h4 class="text-neon-pink font-black text-[10px] md:text-xs tracking-[0.2em] uppercase mb-4 border-b border-white/10 pb-3 flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    Un Poco de Historia
                </h4>
                <p id="cm-history" class="text-slate-400 text-xs md:text-sm leading-relaxed italic border-l-2 border-neon-pink/30 pl-4"></p>
            </div>
        </div>
    </div>
  </div>
</div>

<script>
    import { isCocktailModalOpen, selectedCocktail, closeCocktailModal } from "../../store/cocktailStore";

    document.addEventListener("astro:page-load", () => {
        const modal = document.getElementById("cocktail-modal");
        const modalContainer = modal?.querySelector(".group-modal");
        const closeBtn = document.getElementById("close-modal-btn");
        
        const imgEl = document.getElementById("cm-image") as HTMLImageElement;
        const nameEl = document.getElementById("cm-name");
        const ingEl = document.getElementById("cm-ingredients");
        const histEl = document.getElementById("cm-history");
        const instEl = document.getElementById("cm-instructions");

        if(!modal || !closeBtn) return;

        closeBtn.addEventListener("click", () => {
            closeCocktailModal();
        });
        
        modal.addEventListener("click", (e) => {
            if (e.target === modal) closeCocktailModal();
        });

        const unsubscribeState = isCocktailModalOpen.subscribe((isOpen) => {
            if(isOpen) {
                modal.classList.remove("opacity-0", "pointer-events-none");
                modalContainer?.classList.remove("scale-95");
                modalContainer?.classList.add("scale-100");
                document.body.style.overflow = "hidden";
            } else {
                modal.classList.add("opacity-0", "pointer-events-none");
                modalContainer?.classList.remove("scale-100");
                modalContainer?.classList.add("scale-95");
                document.body.style.overflow = "";
            }
        });

        const unsubscribeData = selectedCocktail.subscribe((cocktail) => {
            if(!cocktail) return;
            
            if(imgEl) imgEl.src = cocktail.image_url || '';
            if(imgEl) imgEl.alt = cocktail.name || '';
            if(nameEl) nameEl.textContent = cocktail.name || '';
            if(histEl) histEl.textContent = cocktail.history || '';
            
            if(ingEl && cocktail.ingredients) {
                ingEl.innerHTML = "";
                cocktail.ingredients.forEach(ing => {
                    const li = document.createElement("li");
                    li.className = "flex items-start gap-3 bg-white/5 p-3 rounded-xl border border-white/5";
                    li.innerHTML = `
                        <span class="w-1.5 h-1.5 mt-1.5 rounded-full bg-neon-blue flex-shrink-0"></span>
                        <div class="flex flex-col">
                            <span class="font-bold text-white text-[13px]">${ing.qty}</span> 
                            <span class="text-slate-400 text-[11px] uppercase tracking-wider">${ing.item}</span>
                        </div>
                    `;
                    ingEl.appendChild(li);
                });
            }

            if(instEl && cocktail.instructions) {
                instEl.innerHTML = "";
                cocktail.instructions.forEach(inst => {
                    const li = document.createElement("li");
                    li.className = "pl-2 pb-2";
                    // Bold keywords in Spanish (AGITAR, MACERAR, SERVIR, DECORAR, REMOVER, PREPARAR EN VASO, etc.)
                    let formattedInst = inst.replace(/^(AGITAR|BATIR|MACERAR|DECORAR|REMOVER|SERVIR|MEZCLAR|PREPARAR EN VASO|CONSTRUIR|MUDDLE|SHAKE|GARNISH|STIR|POUR|BLEND|BUILD):/i, `<span class="font-black text-neon-blue uppercase tracking-widest">$1:</span>`);
                    li.innerHTML = `<span class="ml-2">${formattedInst}</span>`;
                    instEl.appendChild(li);
                });
            }
        });

        // Cleanup on unmount/page navigation
        document.addEventListener("astro:before-swap", () => {
             unsubscribeState();
             unsubscribeData();
        }, { once: true });
    });
</script>

<style>
    .hide-scrollbar::-webkit-scrollbar {
        width: 6px;
    }
    .hide-scrollbar::-webkit-scrollbar-track {
        background: transparent;
    }
    .hide-scrollbar::-webkit-scrollbar-thumb {
        background-color: rgba(255, 255, 255, 0.1);
        border-radius: 10px;
    }
</style>
