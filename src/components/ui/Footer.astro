---
// src/components/ui/Footer.astro
---

<footer class="relative w-full min-h-[12vh] md:min-h-[14vh] bg-transparent overflow-hidden mt-12">
    
    <div class="absolute inset-0 z-10 flex flex-col items-center justify-center pt-2">
        <div class="relative w-full flex items-center justify-center">
            <span id="phrase-1" class="absolute text-[9px] md:text-[10px] font-black uppercase tracking-[0.5em] italic text-white/20">
                DiverpremierGo
            </span>
            <span id="phrase-2" class="absolute text-[9px] md:text-[10px] font-black uppercase tracking-[0.4em] italic text-white/20">
                una experiencia diseñada por otterock
            </span>
        </div>
    </div>

    <div class="absolute bottom-0 left-0 w-full z-20 pointer-events-none wave-container flex flex-col justify-end h-full">
        <svg preserveAspectRatio="none" class="absolute bottom-[-10%] left-0 w-[200%] h-full animate-wave flow-slow opacity-10 fill-cyan-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320">
            <path d="M0,160 Q180,240 360,160 T720,160 Q900,240 1080,160 T1440,160 L1440,320 L0,320 Z"></path>
        </svg>

        <svg preserveAspectRatio="none" class="absolute bottom-[-5%] left-0 w-[200%] h-[90%] animate-wave flow-fast opacity-15 fill-sky-400/30 filter drop-shadow-[0_-8px_12px_rgba(14,165,233,0.15)]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320">
            <path d="M0,200 Q180,260 360,200 T720,200 Q900,260 1080,200 T1440,200 L1440,320 L0,320 Z"></path>
        </svg>
    </div>
</footer>

<style>
    @keyframes wave-flow {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
    }

    .flow-slow {
        animation: wave-flow 15s linear infinite;
    }

    .flow-fast {
        animation: wave-flow 10s linear infinite;
    }

    @keyframes text-cycle-1 {
        0%, 45% { opacity: 1; transform: scale(1); }
        50%, 95% { opacity: 0; transform: scale(0.95); }
        100% { opacity: 1; transform: scale(1); }
    }

    @keyframes text-cycle-2 {
        0%, 45% { opacity: 0; transform: scale(0.95); }
        50%, 95% { opacity: 1; transform: scale(1); }
        100% { opacity: 0; transform: scale(0.95); }
    }

    #phrase-1 {
        animation: text-cycle-1 10s infinite ease-in-out;
    }

    #phrase-2 {
        animation: text-cycle-2 10s infinite ease-in-out;
    }
</style>