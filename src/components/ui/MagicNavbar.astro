---
import { House, Package, Map, Wine, Users, Sun, Moon } from "@lucide/astro";

const pathname = Astro.url.pathname;

const navItems = [
    { href: "/", icon: House, label: "Inicio" },
    { href: "/productos", icon: Package, label: "Tienda" },
    { href: "/mapa", icon: Map, label: "Mapa" },
    { href: "/nosotros", icon: Users, label: "Nosotros" },
    { href: "/cocteleria", icon: Wine, label: "Cócteles" },
];

const activeIndex = navItems.findIndex((item) => {
    const p = pathname.replace(/\/$/, "") || "/";
    const h = item.href.replace(/\/$/, "") || "/";
    return p === h || (h !== "/" && p.startsWith(h));
});

const currentIndex = activeIndex === -1 ? 2 : activeIndex;
---

<div
    class="fixed bottom-0 left-0 w-full flex justify-center z-[5000] md:hidden pb-5 sm:pb-6 px-2 sm:px-3 pointer-events-none"
>
    <nav
        id="magic-navbar"
        transition:persist="magic-navbar"
        class="navigation magic-navbar pointer-events-auto relative w-full max-w-[390px] h-[65px] bg-[#020617]/90 backdrop-blur-xl rounded-full flex justify-center items-center px-1.5 shadow-[0_20px_50px_rgba(0,0,0,0.6)] border border-white/10"
    >
        <div
            class="relative w-full"
            style={`--active-index: ${currentIndex};`}
        >
            <!-- Active Page Indicator Bubble -->
            <div
                class="indicator absolute top-[-28px] min-[390px]:top-[-30px] w-[52px] h-[52px] min-[390px]:w-[58px] min-[390px]:h-[58px] bg-neon-blue/20 backdrop-blur-xl rounded-full border border-white/30 z-0 shadow-[0_10px_30px_rgba(56,189,248,0.4)] pointer-events-none"
            >
                <div
                    class="absolute inset-0 rounded-full bg-gradient-to-b from-white/25 to-transparent"
                >
                </div>
            </div>

            <ul
                class="flex relative w-full justify-between items-center h-full list-none p-0 m-0"
            >
                {
                    navItems.map((item, index) => (
                        <li
                            class={`relative w-[calc(100%/6)] h-[65px] z-10 flex-shrink-0 group flex justify-center items-center ${
                                index === currentIndex ? "active" : ""
                            }`}
                        >
                            <a
                                href={item.href}
                                data-astro-prefetch="hover"
                                class="relative flex justify-center items-center flex-col w-full h-full"
                            >
                                <span class="icon relative block text-white/40 transition-all duration-500 will-change-transform group-[.active]:text-white group-[.active]:scale-110 group-[.active]:-translate-y-[32px] min-[390px]:group-[.active]:-translate-y-[34px]">
                                    <item.icon
                                        size={19}
                                        stroke-width={
                                            index === currentIndex ? 2.5 : 2
                                        }
                                    />
                                </span>

                                <span class="text absolute bottom-[-16px] min-[390px]:bottom-[-18px] text-neon-blue font-black text-[7.5px] min-[360px]:text-[8.5px] min-[390px]:text-[9.5px] tracking-wider opacity-0 transition-all duration-500 group-[.active]:opacity-100 uppercase whitespace-nowrap">
                                    {item.label}
                                </span>
                            </a>
                        </li>
                    ))
                }

                <!-- Theme Toggle (6th Item) -->
                <li
                    class="relative w-[calc(100%/6)] h-[65px] z-10 flex-shrink-0 flex justify-center items-center"
                >
                    <button
                        id="magic-theme-toggle"
                        class="relative flex justify-center items-center w-full h-full cursor-pointer bg-transparent border-none outline-none"
                        aria-label="Toggle Theme"
                    >
                        <!-- Sun Icon (visible in dark mode) -->
                        <span
                            class="theme-icon-sun absolute transition-all duration-500 will-change-transform text-amber-400 drop-shadow-[0_0_8px_rgba(251,191,36,0.6)]"
                        >
                            <Sun size={19} stroke-width={2} />
                        </span>
                        <!-- Moon Icon (visible in light mode) -->
                        <span
                            class="theme-icon-moon absolute transition-all duration-500 will-change-transform text-slate-400 drop-shadow-[0_0_8px_rgba(100,116,139,0.4)] rotate-90 opacity-0 scale-50"
                        >
                            <Moon size={19} stroke-width={2} />
                        </span>
                    </button>
                </li>
            </ul>
        </div>
    </nav>
</div>

<style>
    /* ═══════════════════════════════════════════
       INDICATOR POSITIONING
       ═══════════════════════════════════════════ */
    .indicator {
        /* Fluid 1/6 column alignment: centers bubble on item center for any screen width */
        left: calc((var(--active-index) + 0.5) * (100% / 6));
        transform: translateX(-50%);
        transition: left 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        animation: bubble-glow 3s ease-in-out infinite;
    }

    @keyframes bubble-glow {
        0%,
        100% {
            box-shadow: 0 10px 30px rgba(56, 189, 248, 0.4);
        }
        50% {
            box-shadow: 0 10px 45px rgba(56, 189, 248, 0.6);
        }
    }

    /* ═══════════════════════════════════════════
       THEME TOGGLE ANIMATIONS (GPU-accelerated)
       ═══════════════════════════════════════════ */
    .theme-icon-sun,
    .theme-icon-moon {
        will-change: transform, opacity;
        backface-visibility: hidden;
    }

    /* Light mode active: hide sun, show moon */
    :global(html.light) .theme-icon-sun {
        transform: rotate(90deg);
        opacity: 0;
        scale: 0.5;
    }
    :global(html.light) .theme-icon-moon {
        transform: rotate(0deg);
        opacity: 1;
        scale: 1;
    }

    /* Tap feedback glow */
    #magic-theme-toggle:active {
        animation: toggle-pulse 0.3s ease-out;
    }

    @keyframes toggle-pulse {
        0% {
            filter: drop-shadow(0 0 0px rgba(56, 189, 248, 0));
        }
        50% {
            filter: drop-shadow(0 0 15px rgba(56, 189, 248, 0.6));
        }
        100% {
            filter: drop-shadow(0 0 0px rgba(56, 189, 248, 0));
        }
    }
</style>

<script>
    function initMagicNavbar() {
        const navbar = document.getElementById("magic-navbar");
        if (!navbar) return;

        // ─── Active Page Highlight ───
        const path = window.location.pathname;
        const links = navbar.querySelectorAll("ul > li:not(:last-child) a"); // Exclude toggle
        let activeIdx = 2; // Default (Map)

        links.forEach((a, idx) => {
            const href = a.getAttribute("href");
            if (!href) return;
            const p = path.replace(/\/$/, "") || "/";
            const h = href.replace(/\/$/, "") || "/";
            if (p === h || (h !== "/" && p.startsWith(h))) {
                activeIdx = idx;
            }
        });

        const container = navbar.querySelector(
            "[style*='--active-index']",
        ) as HTMLElement;
        if (container) {
            container.style.setProperty("--active-index", activeIdx.toString());
        }

        const items = navbar.querySelectorAll("ul > li:not(:last-child)");
        items.forEach((li, idx) => {
            if (idx === activeIdx) {
                li.classList.add("active");
            } else {
                li.classList.remove("active");
            }
        });

        // ─── Theme Toggle Logic ───
        const toggleBtn = document.getElementById("magic-theme-toggle");
        if (!toggleBtn) return;

        // Remove previous handler to prevent duplicates on View Transitions
        if ((window as any).__magicThemeHandler) {
            toggleBtn.removeEventListener(
                "click",
                (window as any).__magicThemeHandler,
            );
        }

        (window as any).__magicThemeHandler = () => {
            const isLight = document.documentElement.classList.toggle("light");
            localStorage.setItem("theme", isLight ? "light" : "dark");

            // Sync the desktop ThemeToggle button state if it exists
            const desktopToggle = document.getElementById("theme-toggle");
            if (desktopToggle) {
                if (isLight) {
                    desktopToggle.classList.add("is-light");
                } else {
                    desktopToggle.classList.remove("is-light");
                }
            }
        };

        toggleBtn.addEventListener(
            "click",
            (window as any).__magicThemeHandler,
        );

        // ─── Theme Icon Persistence Init (No Flicker) ───
        const sunIcon = document.querySelector(".theme-icon-sun") as HTMLElement;
        const moonIcon = document.querySelector(".theme-icon-moon") as HTMLElement;

        if (sunIcon && moonIcon) {
            // Temporarily disable CSS transitions
            sunIcon.classList.remove("transition-all", "duration-500");
            moonIcon.classList.remove("transition-all", "duration-500");

            // Force reflow so the browser renders them in their final state instantly
            void sunIcon.offsetWidth;
            void moonIcon.offsetWidth;

            // Re-eneable transitions after a short delay
            setTimeout(() => {
                sunIcon.classList.add("transition-all", "duration-500");
                moonIcon.classList.add("transition-all", "duration-500");
            }, 50);
        }

        // ─── MutationObserver: Sync icon state when desktop toggle fires ───
        if ((window as any).__magicThemeObserver) {
            (window as any).__magicThemeObserver.disconnect();
        }

        (window as any).__magicThemeObserver = new MutationObserver(
            (mutations: MutationRecord[]) => {
                for (const mutation of mutations) {
                    if (mutation.attributeName === "class") {
                        // Icons auto-sync via :global(html.light) CSS — no JS needed
                        // But we do need to sync the desktop button class
                        const isLight =
                            document.documentElement.classList.contains(
                                "light",
                            );
                        const desktopToggle =
                            document.getElementById("theme-toggle");
                        if (desktopToggle) {
                            if (isLight) {
                                desktopToggle.classList.add("is-light");
                            } else {
                                desktopToggle.classList.remove("is-light");
                            }
                        }
                    }
                }
            },
        );

        (window as any).__magicThemeObserver.observe(document.documentElement, {
            attributes: true,
            attributeFilter: ["class"],
        });
    }

    document.addEventListener("astro:page-load", initMagicNavbar);
</script>
