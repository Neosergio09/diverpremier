---
export const prerender = true;

import MainLayout from "@layouts/MainLayout.astro";
import LiquidBackground from "@components/ui/LiquidBackground.astro";
---

<MainLayout title="Acceso al Búnker | Diverpremier" hideFooter={true}>
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap"
    rel="stylesheet"
  />

  <LiquidBackground />

  <div
    class="fixed inset-0 flex items-center justify-center md:justify-end md:pr-80 px-6 z-10 overflow-hidden"
  >
    <div
      class="hidden md:flex absolute left-10 lg:left-40 bottom-0 w-1/2 h-4/5 items-end justify-start pointer-events-none select-none"
    >
      <svg
        viewBox="0 0 500 500"
        class="w-full h-full drop-shadow-[0_20px_50px_rgba(0,0,0,0.3)] overflow-visible"
      >
        <g>
          <rect
            x="240"
            y="220"
            width="70"
            height="180"
            rx="12"
            fill="#11021b"
            stroke="#38BDF8"
            stroke-width="0.5"></rect>
          <g id="char-black" class="character-face" data-speed="0.08">
            <circle cx="265" cy="250" r="8" fill="white"></circle>
            <circle cx="265" cy="250" r="4" fill="black" class="eye-pupil"
            ></circle>
            <circle cx="285" cy="250" r="8" fill="white"></circle>
            <circle cx="285" cy="250" r="4" fill="black" class="eye-pupil"
            ></circle>
            <line
              x1="265"
              y1="285"
              x2="285"
              y2="285"
              stroke="white"
              stroke-width="1.5"
              stroke-linecap="round"></line>
          </g>
        </g>
        <g>
          <rect x="130" y="100" width="110" height="300" rx="20" fill="#D052FF"
          ></rect>
          <g id="char-purple" class="character-face" data-speed="0.12">
            <ellipse cx="165" cy="150" rx="12" ry="15" fill="white"></ellipse>
            <circle cx="165" cy="150" r="6" fill="black" class="eye-pupil"
            ></circle>
            <ellipse cx="205" cy="150" rx="12" ry="15" fill="white"></ellipse>
            <circle cx="205" cy="150" r="6" fill="black" class="eye-pupil"
            ></circle>
            <path
              d="M170,210 Q185,230 200,210"
              fill="none"
              stroke="black"
              stroke-width="3"
              stroke-linecap="round"></path>
          </g>
        </g>
        <g>
          <path
            d="M260,400 L260,320 C260,280 300,280 340,280 C380,280 380,320 380,400 Z"
            fill="#BEF264"></path>
          <g id="char-lime" class="character-face" data-speed="0.1">
            <circle cx="320" cy="315" r="10" fill="white"></circle>
            <circle cx="320" cy="315" r="5" fill="black" class="eye-pupil"
            ></circle>
            <circle cx="320" cy="345" r="4" fill="black"></circle>
          </g>
        </g>
        <g>
          <path d="M40,400 A100,100 0 0,1 240,400 Z" fill="#FB923C"></path>
          <g id="char-orange" class="character-face" data-speed="0.15">
            <circle cx="160" cy="330" r="7" fill="black" class="eye-pupil"
            ></circle>
            <circle cx="190" cy="330" r="7" fill="black" class="eye-pupil"
            ></circle>
            <path
              d="M165,360 Q175,370 185,360"
              fill="none"
              stroke="black"
              stroke-width="3"
              stroke-linecap="round"></path>
          </g>
        </g>
      </svg>
    </div>

    <div
      class="w-full max-w-md backdrop-blur-3xl bg-white/[0.03] ring-1 ring-white/20 border border-white/10 rounded-[3rem] p-10 md:p-12 shadow-2xl relative overflow-hidden group z-10"
    >
      <div
        class="absolute -top-32 -right-32 w-64 h-64 bg-neon-blue/15 blur-[100px] rounded-full pointer-events-none"
      >
      </div>

      <!-- Barra superior: Enlace volver a la tienda & badge -->
      <div class="flex items-center justify-between mb-8 relative z-10">
        <a
          href="/"
          class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-neutral-400 hover:text-neon-blue transition-colors duration-300 group/back py-1.5 px-3.5 rounded-full bg-white/[0.03] border border-white/10 hover:border-neon-blue/40"
          title="Volver a la tienda principal"
        >
          <svg class="w-3.5 h-3.5 transition-transform duration-300 group-hover/back:-translate-x-1 text-neutral-400 group-hover/back:text-neon-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>Tienda</span>
        </a>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] uppercase font-mono tracking-widest bg-white/[0.02] border border-white/5 text-neutral-400">
          <span class="w-1.5 h-1.5 rounded-full bg-neon-blue animate-pulse"></span>
          Búnker Admin
        </span>
      </div>

      <div class="relative z-10 text-center">
        <h1
          class="text-5xl font-['Bebas_Neue'] text-white tracking-widest uppercase italic mb-8"
        >
          DIVERPREMIER <span class="text-neon-blue neon-glow-text">GO</span>
        </h1>

        <form id="login-form" class="space-y-6">
          <!-- Campo Email con icono y autofocus -->
          <div class="space-y-2 text-left">
            <label for="email-field" class="block text-[11px] font-mono uppercase tracking-widest text-neutral-400">
              Credencial / Correo
            </label>
            <div class="relative group/input">
              <div class="absolute left-5 top-1/2 -translate-y-1/2 text-neutral-500 group-focus-within/input:text-neon-blue transition-colors pointer-events-none">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207" />
                </svg>
              </div>
              <input
                type="email"
                id="email-field"
                placeholder="agente@diverpremier.go"
                class="input-bunker pl-12 pr-6"
                autocomplete="username"
                required
                autofocus
              />
            </div>
          </div>

          <!-- Campo Contraseña con icono y botón Mostrar/Ocultar -->
          <div class="space-y-2 text-left">
            <div class="flex items-center justify-between">
              <label for="pass-field" class="block text-[11px] font-mono uppercase tracking-widest text-neutral-400">
                Clave de Seguridad
              </label>
            </div>
            <div class="relative group/input">
              <div class="absolute left-5 top-1/2 -translate-y-1/2 text-neutral-500 group-focus-within/input:text-neon-blue transition-colors pointer-events-none">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
              </div>
              <input
                type="password"
                id="pass-field"
                placeholder="••••••••••••"
                class="input-bunker pl-12 pr-12"
                autocomplete="current-password"
                required
              />
              <button
                type="button"
                id="toggle-password-btn"
                class="absolute right-4 top-1/2 -translate-y-1/2 p-1.5 text-neutral-500 hover:text-neon-blue focus:text-neon-blue transition-colors rounded-lg focus:outline-none cursor-pointer"
                title="Mostrar u ocultar contraseña"
                aria-label="Alternar visibilidad de contraseña"
              >
                <!-- Eye icon (mostrar) -->
                <svg id="eye-icon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                <!-- Eye-off icon (ocultar) -->
                <svg id="eye-off-icon" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                </svg>
              </button>
            </div>
          </div>

          <!-- Caja de Error y Rate Limit con Cuenta Regresiva Activa -->
          <div
            id="auth-error-box"
            class="hidden p-3.5 rounded-2xl bg-red-500/10 border border-red-500/25 text-red-400 text-xs transition-all duration-300"
            role="alert"
          >
            <div class="flex items-start gap-2.5">
              <div class="text-red-400 shrink-0 mt-0.5" id="auth-error-icon">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
              </div>
              <div class="flex-1 text-left">
                <p id="auth-error-title" class="font-bold uppercase tracking-wider text-[10px] text-red-300">Acceso Denegado</p>
                <p id="auth-error-msg" class="text-neutral-300 text-[11px] leading-relaxed mt-0.5">Credenciales no válidas.</p>
                <div id="countdown-wrapper" class="hidden mt-2 pt-2 border-t border-red-500/20 flex items-center justify-between text-[11px] font-mono">
                  <span class="text-neutral-400">Reintento disponible en:</span>
                  <span id="countdown-timer" class="font-bold text-amber-400">30s</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Botón de Envío con Indicador Spinner -->
          <button
            type="submit"
            id="submit-btn"
            class="btn-bunker flex items-center justify-center gap-3 relative overflow-hidden"
          >
            <svg
              id="submit-spinner"
              class="w-5 h-5 animate-spin hidden text-neon-blue"
              fill="none"
              viewBox="0 0 24 24"
            >
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
            </svg>
            <span id="submit-text">Entrar al Búnker</span>
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- FOOTER -->
  <footer slot="page-footer" class="fixed bottom-[max(2rem,env(safe-area-inset-bottom))] w-full z-20 md:pr-80 px-6 flex justify-center md:justify-end pointer-events-none">
    <div class="w-full max-w-md flex flex-col items-center justify-center gap-1.5 pointer-events-auto">
      <div class="flex items-center gap-2 text-[10px] uppercase tracking-[0.2em] text-white/30 hover:text-neon-blue transition-colors duration-300 cursor-default">
        <span class="relative flex h-1.5 w-1.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-green-500"></span>
        </span>
        Secure Connection Established
      </div>
      <div class="text-[10px] tracking-[0.2em] text-white/30 hover:text-neon-blue transition-colors duration-300 cursor-default">
        © 2026 OTTEROCK DIGITAL
      </div>
    </div>
  </footer>
</MainLayout>

<script>
  const faces = document.querySelectorAll(".character-face");
  const pupils = document.querySelectorAll(".eye-pupil");
  const emailInput = document.getElementById("email-field") as HTMLInputElement;
  const passInput = document.getElementById("pass-field") as HTMLInputElement;
  const togglePasswordBtn = document.getElementById("toggle-password-btn") as HTMLButtonElement;
  const eyeIcon = document.getElementById("eye-icon");
  const eyeOffIcon = document.getElementById("eye-off-icon");
  const loginForm = document.getElementById("login-form") as HTMLFormElement;
  const authErrorBox = document.getElementById("auth-error-box");
  const authErrorTitle = document.getElementById("auth-error-title");
  const authErrorMsg = document.getElementById("auth-error-msg");
  const countdownWrapper = document.getElementById("countdown-wrapper");
  const countdownTimer = document.getElementById("countdown-timer");
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
  const submitSpinner = document.getElementById("submit-spinner");
  const submitText = document.getElementById("submit-text");

  let isAnimating = false;
  let countdownInterval: any = null;

  const setMode = (mode: string) => {
    const config =
      mode === "anim"
        ? "transform 1s cubic-bezier(0.4, 0, 0.2, 1)"
        : "transform 0.15s ease-out";
    faces.forEach((f) => ((f as any).style.transition = config));
    pupils.forEach((p) => ((p as any).style.transition = config));
  };

  // 🖱️ Seguimiento de mirada independiente con el cursor
  window.addEventListener("mousemove", (e) => {
    if (isAnimating) return;
    const x = (e.clientX - window.innerWidth / 2) / (window.innerWidth / 2);
    const y = (e.clientY - window.innerHeight / 2) / (window.innerHeight / 2);

    faces.forEach((f) => {
      const s = parseFloat(f.getAttribute("data-speed") || "0.1");
      (f as any).style.transform = `translate(${x * (s * 40)}px, ${
        y * (s * 30)
      }px)`;
    });

    pupils.forEach((p) => {
      // Las pupilas se mueven un poco más que la cara para dar profundidad
      (p as any).style.transform = `translate(${x * 6}px, ${y * 4}px)`;
    });
  });

  // 🕵️ Secuencia al enfocar Email
  emailInput?.addEventListener("focus", () => {
    if (isAnimating) return;
    isAnimating = true;
    setMode("anim");

    const c = {
      black: document.getElementById("char-black"),
      purple: document.getElementById("char-purple"),
      lime: document.getElementById("char-lime"),
      orange: document.getElementById("char-orange"),
    };

    // Mirada coordinada
    if (c.black) c.black.style.transform = "translate(-15px, 10px)";
    if (c.purple) c.purple.style.transform = "translate(10px, 15px)";
    if (c.lime) c.lime.style.transform = "translate(-20px, 5px)";
    if (c.orange) c.orange.style.transform = "translate(5px, -5px)";

    pupils.forEach(
      (p) => ((p as any).style.transform = "translate(-3px, 2px)")
    );

    setTimeout(() => c.orange?.classList.add("nodding"), 1200);

    setTimeout(() => {
      c.orange?.classList.remove("nodding");
      faces.forEach(
        (f) => ((f as any).style.transform = "translate(25px, 5px)")
      );
      pupils.forEach(
        (p) => ((p as any).style.transform = "translate(4px, 0px)")
      );
    }, 2500);

    setTimeout(() => {
      isAnimating = false;
      setMode("mouse");
    }, 5000);
  });

  // 🔒 Campo Contraseña (Modo Privacidad)
  passInput?.addEventListener("focus", () => {
    if (passInput.type === "text") return; // Si la clave está visible, no se tapan
    isAnimating = true;
    setMode("anim");
    faces.forEach(
      (f) => ((f as any).style.transform = "translate(-20px, -5px) scaleX(0.9)")
    );
    pupils.forEach(
      (p) => ((p as any).style.transform = "translate(-5px, -1px)")
    );
  });

  passInput?.addEventListener("blur", () => {
    if (passInput.type === "text") return;
    isAnimating = false;
    faces.forEach((f) => ((f as any).style.transform = "scaleX(1)"));
    setMode("mouse");
  });

  // 👁️ Mostrar / Ocultar Contraseña
  togglePasswordBtn?.addEventListener("click", () => {
    const isPassword = passInput.type === "password";
    passInput.type = isPassword ? "text" : "password";

    if (isPassword) {
      eyeIcon?.classList.add("hidden");
      eyeOffIcon?.classList.remove("hidden");
      togglePasswordBtn.setAttribute("aria-label", "Ocultar contraseña");
      togglePasswordBtn.setAttribute("title", "Ocultar contraseña");

      // Micro-animación: los personajes abren los ojos y observan la clave descubierta
      setMode("anim");
      faces.forEach((f) => ((f as any).style.transform = "translate(15px, 0px) scale(1.04)"));
      pupils.forEach((p) => ((p as any).style.transform = "translate(5px, 0px) scale(1.1)"));
    } else {
      eyeIcon?.classList.remove("hidden");
      eyeOffIcon?.classList.add("hidden");
      togglePasswordBtn.setAttribute("aria-label", "Mostrar contraseña");
      togglePasswordBtn.setAttribute("title", "Mostrar contraseña");

      // Regreso a postura discreta
      setMode("anim");
      faces.forEach((f) => ((f as any).style.transform = "translate(-20px, -5px) scaleX(0.9)"));
      pupils.forEach((p) => ((p as any).style.transform = "translate(-5px, -1px)"));
    }
  });

  // ⏱️ Manejo de Cuenta Regresiva de Rate Limit (Fuerza Bruta)
  const startRateLimitCountdown = (seconds: number) => {
    if (countdownInterval) clearInterval(countdownInterval);
    let remaining = seconds;

    if (countdownWrapper && countdownTimer) {
      countdownWrapper.classList.remove("hidden");
      countdownTimer.innerText = `${remaining}s`;
    }

    submitBtn.disabled = true;
    submitBtn.classList.add("opacity-50", "cursor-not-allowed");
    if (submitText) submitText.innerText = `Espera (${remaining}s)`;

    countdownInterval = setInterval(() => {
      remaining--;
      if (countdownTimer) countdownTimer.innerText = `${remaining}s`;
      if (submitText) submitText.innerText = `Espera (${remaining}s)`;

      if (remaining <= 0) {
        clearInterval(countdownInterval);
        countdownInterval = null;
        if (countdownWrapper) countdownWrapper.classList.add("hidden");
        if (authErrorBox) authErrorBox.classList.add("hidden");
        submitBtn.disabled = false;
        submitBtn.classList.remove("opacity-50", "cursor-not-allowed");
        if (submitText) submitText.innerText = "Entrar al Búnker";
      }
    }, 1000);
  };

  // 🔐 Envío del Formulario & Autenticación Server-Side
  loginForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (isAnimating || countdownInterval) return;

    // Estado de carga
    submitBtn.disabled = true;
    submitSpinner?.classList.remove("hidden");
    if (submitText) submitText.innerText = "Verificando...";
    submitBtn.classList.add("opacity-70", "cursor-wait");
    if (authErrorBox) authErrorBox.classList.add("hidden");

    const email = emailInput.value.trim();
    const password = passInput.value;

    try {
      const response = await fetch("/api/login", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, password }),
      });

      const result = await response.json();
      submitSpinner?.classList.add("hidden");

      if (!response.ok) {
        isAnimating = true;
        setMode("anim");

        if (response.status === 429) {
          // 🛑 Bloqueo por exceso de intentos fallidos (Fuerza Bruta)
          const waitSeconds = result.retryAfter || 120;
          if (authErrorTitle) authErrorTitle.innerText = "LÍMITE DE SEGURIDAD ACTIVADO";
          if (authErrorMsg) authErrorMsg.innerText = result.error || "Demasiados intentos fallidos.";
          if (authErrorBox) authErrorBox.classList.remove("hidden");
          startRateLimitCountdown(waitSeconds);
        } else {
          // ❌ Error normal de credenciales
          if (authErrorTitle) authErrorTitle.innerText = "ACCESO DENEGADO";
          if (authErrorMsg) authErrorMsg.innerText = result.error || "Credenciales no válidas.";
          if (countdownWrapper) countdownWrapper.classList.add("hidden");
          if (authErrorBox) authErrorBox.classList.remove("hidden");

          submitBtn.disabled = false;
          submitBtn.classList.remove("opacity-70", "cursor-wait");
          if (submitText) submitText.innerText = "Entrar al Búnker";
        }

        // Animación de cabeza negando (shake head)
        faces.forEach((f) => ((f as any).style.transform = "translate(0px, 15px) rotate(-10deg)"));
        pupils.forEach((p) => ((p as any).style.transform = "translate(0px, 5px)"));

        setTimeout(() => {
          faces.forEach((f) => ((f as any).style.transform = "translate(0px, 15px) rotate(10deg)"));
        }, 300);

        setTimeout(() => {
          faces.forEach((f) => ((f as any).style.transform = "translate(0px, 15px) rotate(-10deg)"));
        }, 600);

        setTimeout(() => {
          isAnimating = false;
          faces.forEach((f) => ((f as any).style.transform = "rotate(0deg) translate(0px, 0px)"));
          pupils.forEach((p) => ((p as any).style.transform = "translate(0px, 0px)"));
          setMode("mouse");
        }, 1200);

      } else {
        // ✅ Éxito en autenticación
        isAnimating = true;
        setMode("anim");

        if (submitText) submitText.innerText = "ACCESO CONCEDIDO";
        submitBtn.classList.remove("bg-neon-blue/5", "text-neon-blue", "border-neon-blue/20", "opacity-70", "cursor-wait");
        submitBtn.classList.add("bg-green-500/20", "text-green-400", "border-green-500/50");

        faces.forEach((f) => ((f as any).style.transform = "translate(0px, -20px) scale(1.1)"));
        pupils.forEach((p) => ((p as any).style.transform = "translate(0px, -5px) scale(1.1)"));

        setTimeout(() => {
          faces.forEach((f) => ((f as any).style.transform = "translate(0px, -10px) scale(1.05)"));
        }, 500);

        setTimeout(() => {
          window.location.href = "/admin";
        }, 1100);
      }
    } catch (networkErr) {
      console.error("Error en petición de autenticación:", networkErr);
      submitSpinner?.classList.add("hidden");
      if (authErrorTitle) authErrorTitle.innerText = "ERROR DE CONEXIÓN";
      if (authErrorMsg) authErrorMsg.innerText = "No fue posible conectar con el búnker. Revisa tu conexión de red.";
      if (countdownWrapper) countdownWrapper.classList.add("hidden");
      if (authErrorBox) authErrorBox.classList.remove("hidden");

      submitBtn.disabled = false;
      submitBtn.classList.remove("opacity-70", "cursor-wait");
      if (submitText) submitText.innerText = "Entrar al Búnker";
    }
  });
</script>


