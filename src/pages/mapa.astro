---
export const prerender = true;

import MainLayout from "../layouts/MainLayout.astro";
import {
  MapPin,
  MessageCircle,
  Navigation,
  Search,
  Crosshair,
  ExternalLink,
} from "@lucide/astro";
---

<MainLayout
  title="Búnker Central & Cobertura Táctica | Diverpremier"
  isProse={false}
  containerClass="p-0 m-0 max-w-none h-screen w-full relative overflow-hidden bg-dark-bg"
>
  <Fragment slot="head">
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      crossorigin=""
    />
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
  </Fragment>

  <!-- Leaflet Map Container -->
  <div id="tactical-map" class="absolute inset-0 z-0"></div>

  <!-- Cinematic Vignette Overlay -->
  <div
    class="absolute inset-0 z-[1] pointer-events-none shadow-[inset_0_0_120px_rgba(0,0,0,0.7)]"
  >
  </div>

  <!-- ═══════════════════════════════════════════════════════
       BARRA DE BÚSQUEDA Y NORMALIZADOR ESTILO PIBOX
       ═══════════════════════════════════════════════════════ -->
  <div
    id="search-panel"
    class="fixed top-4 md:top-28 left-3 right-3 md:left-8 md:right-auto md:w-[380px] lg:w-[420px] z-[1000]"
  >
    <div
      class="glass-neon p-3.5 md:p-4 rounded-2xl md:rounded-3xl border border-white/10 bg-[#020617]/90 backdrop-blur-xl shadow-[0_15px_40px_rgba(0,0,0,0.6)] flex flex-col gap-2"
    >
      <div class="flex items-center justify-between px-1">
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-teal-400 animate-pulse shadow-[0_0_8px_#2dd4bf]"></span>
          <span class="text-[9px] font-black uppercase tracking-[0.2em] text-teal-400">
            Localizador Táctico
          </span>
        </div>
        <span class="text-[9px] font-mono text-slate-400 uppercase tracking-widest">
          Álamos • Bachué
        </span>
      </div>

      <!-- Input Form -->
      <form id="address-form" class="relative flex items-center gap-1.5">
        <div class="relative flex-1">
          <input
            type="text"
            id="address-input"
            placeholder="Dirección o barrio (ej: Cl 72 # 110-20)..."
            autocomplete="off"
            class="w-full bg-white/5 border border-white/10 rounded-xl px-3.5 py-2.5 pl-9 text-xs text-white placeholder:text-slate-400 focus:outline-none focus:border-teal-400/60 focus:bg-teal-400/5 transition-all shadow-inner"
          />
          <Search
            size={14}
            class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none"
          />
        </div>

        <!-- GPS Button -->
        <button
          type="button"
          id="btn-gps"
          title="Usar mi ubicación GPS actual"
          class="p-2.5 rounded-xl border border-white/10 bg-white/5 hover:bg-teal-400/20 hover:border-teal-400/40 text-teal-400 transition-all cursor-pointer flex-shrink-0"
        >
          <Crosshair size={16} />
        </button>

        <!-- Search Button -->
        <button
          type="submit"
          id="btn-search"
          class="px-3.5 py-2.5 rounded-xl border border-teal-400/30 bg-teal-400/10 hover:bg-teal-400 hover:text-dark-bg text-teal-400 text-[10px] font-black uppercase tracking-wider transition-all cursor-pointer flex-shrink-0"
        >
          Buscar
        </button>
      </form>

      <!-- Feedback de Normalización & Estado -->
      <div id="search-feedback" class="hidden px-2 pt-1 flex items-center justify-between text-[9px] font-medium border-t border-white/5">
        <span id="normalized-text" class="text-slate-400 truncate max-w-[250px]"></span>
        <button
          type="button"
          id="btn-reset-map"
          class="text-teal-400/80 hover:text-teal-300 underline uppercase tracking-wider text-[8px] cursor-pointer ml-2 flex-shrink-0"
        >
          Centrar Búnker
        </button>
      </div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════
       PANEL DE INFORMACIÓN DEL BÚNKER & COBERTURA
       ═══════════════════════════════════════════════════════ -->
  <div
    id="info-panel"
    class="fixed bottom-[85px] md:bottom-auto md:top-28 left-2 right-2 sm:left-3 sm:right-3 md:left-auto md:right-8 z-[1000] max-h-[70vh] md:max-h-[85vh] overflow-y-auto no-scrollbar transition-all duration-300"
  >
    <div
      class="info-card glass-neon p-3.5 sm:p-4 md:p-6 rounded-2xl md:rounded-3xl border border-white/10 w-full md:w-[85vw] max-w-[340px] lg:max-w-[360px] mx-auto md:mx-0 shadow-[0_20px_50px_rgba(0,0,0,0.6)] flex flex-col gap-2.5 sm:gap-3.5 md:gap-4 backdrop-blur-xl"
    >
      <!-- Mobile Grabber Toggle Button -->
      <button
        type="button"
        id="mobile-panel-grabber"
        class="flex md:hidden flex-col items-center justify-center w-full py-1 -mt-1 cursor-pointer group bg-transparent border-0 outline-none select-none"
        aria-label="Alternar visibilidad del panel"
      >
        <div class="w-10 h-1 rounded-full bg-white/25 group-hover:bg-teal-400/80 transition-colors"></div>
        <span id="grabber-status-text" class="text-[7.5px] font-mono uppercase tracking-widest text-slate-400 mt-1">
          Tocar para contraer
        </span>
      </button>

      <!-- Header Búnker Seleccionado (Siempre visible en móvil) -->
      <div class="flex justify-between items-start pb-2.5 sm:pb-3 border-b border-white/10">
        <div>
          <div class="flex items-center gap-1.5">
            <span id="bunker-tag" class="text-[8px] sm:text-[9px] font-black uppercase tracking-[0.2em] text-teal-400">Búnker Central</span>
            <span id="stat-mini-pill" class="md:hidden text-[7.5px] font-mono font-bold px-1.5 py-0.5 rounded bg-teal-400/10 text-teal-300 border border-teal-400/20">0.0 KM • 15 MIN</span>
          </div>
          <h2 id="bunker-name" class="info-title font-black uppercase tracking-tight text-base sm:text-lg md:text-xl leading-tight text-white mt-0.5">
            Álamos Norte
          </h2>
          <p class="text-[9.5px] sm:text-[10px] text-slate-400 flex items-center gap-1 mt-0.5">
            <MapPin size={11} class="text-teal-400 flex-shrink-0" />
            <span id="bunker-address" class="truncate max-w-[190px] sm:max-w-none">Cl. 71B # 100-38, Engativá, Bogotá</span>
          </p>
        </div>
        <div class="status-badge-live flex items-center gap-1.5 px-2 sm:px-2.5 py-0.5 sm:py-1 rounded-full border border-teal-400/30 bg-teal-400/10 flex-shrink-0">
          <span class="w-1.5 h-1.5 rounded-full bg-teal-400 animate-pulse shadow-[0_0_8px_#2dd4bf]"></span>
          <span class="text-teal-400 text-[8.5px] sm:text-[9px] font-bold uppercase tracking-wider">OPEN</span>
        </div>
      </div>

      <!-- Contenido Plegable en Móvil -->
      <div id="panel-expandable-body" class="flex flex-col gap-2.5 sm:gap-3.5 md:gap-4 transition-all duration-300">
        <!-- Selector de Sedes / Búnkers -->
        <div class="space-y-1.5">
          <div class="flex items-center justify-between px-1">
            <span class="text-[8px] font-black uppercase tracking-[0.2em] text-slate-400">Seleccionar Búnker</span>
            <span class="text-[8px] font-mono text-teal-400 font-bold uppercase">2 Sedes</span>
          </div>
          <div class="flex items-center p-1 bg-white/5 border border-white/10 rounded-2xl gap-1">
            <button
              type="button"
              id="tab-bunker-alamos"
              class="bunker-tab active flex-1 py-1.5 px-2 rounded-xl text-[8.5px] sm:text-[9px] font-black uppercase tracking-wider transition-all text-white bg-teal-500/20 border border-teal-500/40 shadow-sm cursor-pointer"
              data-bunker-id="alamos"
            >
              Álamos Norte
            </button>
            <button
              type="button"
              id="tab-bunker-bachue"
              class="bunker-tab flex-1 py-1.5 px-2 rounded-xl text-[8.5px] sm:text-[9px] font-black uppercase tracking-wider transition-all text-slate-400 hover:text-white border border-transparent cursor-pointer"
              data-bunker-id="bachue"
            >
              Ciudad Bachué
            </button>
          </div>
        </div>

        <!-- Botones "Cómo Llegar" al Negocio (Waze / Google Maps) -->
        <div class="space-y-1.5">
          <p class="text-[8px] font-black uppercase tracking-[0.2em] text-slate-400">
            Navegar hacia el Búnker Activo
          </p>
          <div class="grid grid-cols-2 gap-2">
            <a
              id="link-bunker-gmaps"
              href="https://www.google.com/maps/dir/?api=1&destination=4.7026601,-74.1174237"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-1.5 py-2 px-2 rounded-xl border border-white/10 bg-white/5 hover:bg-white/10 hover:border-white/20 text-white text-[8.5px] sm:text-[9px] font-bold tracking-wider uppercase transition-all"
            >
              <span>Google Maps</span>
              <ExternalLink size={11} class="text-teal-400" />
            </a>
            <a
              id="link-bunker-waze"
              href="https://waze.com/ul?ll=4.7026601,-74.1174237&navigate=yes"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-1.5 py-2 px-2 rounded-xl border border-teal-400/20 bg-teal-400/5 hover:bg-teal-400/15 hover:border-teal-400/40 text-teal-400 text-[8.5px] sm:text-[9px] font-bold tracking-wider uppercase transition-all"
            >
              <span>Waze</span>
              <Navigation size={11} class="text-teal-400" />
            </a>
          </div>
        </div>

        <!-- Sección de Cobertura Interactiva Dinámica -->
        <div
          id="coverage-status-box"
          class="p-2.5 sm:p-3 rounded-2xl border border-teal-400/20 bg-teal-400/5 transition-all duration-300"
        >
          <div class="flex items-center justify-between mb-1.5 sm:mb-2">
            <span class="text-[8px] font-black uppercase tracking-[0.2em] text-slate-400">
              Estado de Cobertura
            </span>
            <span id="coverage-badge" class="text-[7.5px] sm:text-[8px] font-black uppercase tracking-wider px-2 py-0.5 rounded-full border border-teal-400/40 bg-teal-400/10 text-teal-400">
              ZONA FLASH ⚡
            </span>
          </div>

          <div class="grid grid-cols-2 gap-2 text-center">
            <div class="p-1.5 sm:p-2 rounded-xl bg-white/5 border border-white/5">
              <span class="text-[7.5px] sm:text-[8px] uppercase tracking-wider text-slate-400 block">Distancia</span>
              <span id="stat-distance" class="text-xs sm:text-base font-black text-white">0.0 KM</span>
            </div>
            <div class="p-1.5 sm:p-2 rounded-xl bg-white/5 border border-white/5">
              <span class="text-[7.5px] sm:text-[8px] uppercase tracking-wider text-slate-400 block">Entrega Estimada</span>
              <span id="stat-time" class="text-xs sm:text-base font-black text-teal-400">15 - 25 MIN</span>
            </div>
          </div>

          <p id="coverage-note" class="text-[8.5px] sm:text-[9px] text-slate-400 text-center mt-1.5 sm:mt-2 leading-relaxed">
            📍 Toca cualquier punto del mapa o busca tu dirección para verificar la entrega en tu puerta.
          </p>
        </div>

        <!-- Botón Pedir a este punto por WhatsApp -->
        <a
          id="btn-whatsapp-delivery"
          href="https://wa.me/573114940503?text=Hola%20Diverpremier,%20quiero%20hacer%20un%20pedido%20para%20Central%20%C3%81lamos."
          target="_blank"
          rel="noopener noreferrer"
          class="cta-btn group relative w-full py-3 sm:py-3.5 rounded-xl overflow-hidden transition-all duration-300 hover:scale-[1.02] flex items-center justify-center gap-2 cursor-pointer border"
        >
          <MessageCircle
            size={15}
            class="text-teal-400 group-hover:scale-110 transition-transform"
          />
          <span
            id="btn-whatsapp-label"
            class="text-teal-400 font-black text-[9.5px] sm:text-[10px] tracking-[0.18em] uppercase"
          >
            Consultar Domicilio
          </span>
        </a>
      </div>
    </div>
  </div>
</MainLayout>

<style is:global>
  /* ═══════════════════════════════════════════
     LEAFLET CONTAINER – THEME-AWARE
     ═══════════════════════════════════════════ */
  #tactical-map {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    min-height: 100vh;
    z-index: 0;
  }

  .leaflet-container {
    background: var(--color-dark-bg) !important;
    transition: background-color 0.5s ease;
  }

  .leaflet-control-attribution {
    display: none !important;
  }

  /* ═══════════════════════════════════════════
     DARK & LIGHT TILE FILTERS (OSM CLEAN TILES)
     ═══════════════════════════════════════════ */
  html:not(.light) .leaflet-tile-pane {
    filter: invert(100%) hue-rotate(180deg) brightness(80%) contrast(110%);
  }

  html.light .leaflet-tile-pane {
    filter: contrast(95%) brightness(98%);
  }

  /* ═══════════════════════════════════════════
     MARKER PULSE ANIMATIONS
     ═══════════════════════════════════════════ */
  .neon-teal-marker, .neon-pink-marker {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .pulse-ring {
    animation: pulse-ring 2s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
  }

  @keyframes pulse-ring {
    0% {
      transform: scale(0.5);
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
    100% {
      transform: scale(1.5);
      opacity: 0;
    }
  }

  /* ═══════════════════════════════════════════
     ADAPTIVE THEME STYLES
     ═══════════════════════════════════════════ */
  .info-card {
    background: rgba(2, 6, 23, 0.88);
    transition:
      background-color 0.5s ease,
      border-color 0.5s ease,
      box-shadow 0.5s ease;
  }
  .info-title {
    color: #fff;
  }
  .status-badge-live {
    background: rgba(45, 212, 191, 0.1);
    border-color: rgba(45, 212, 191, 0.2);
  }
  .cta-btn {
    background: linear-gradient(
      to right,
      rgba(20, 184, 166, 0.12),
      rgba(45, 212, 191, 0.22)
    );
    border-color: rgba(45, 212, 191, 0.35);
  }
  .cta-btn:hover {
    box-shadow: 0 0 30px rgba(45, 212, 191, 0.25);
  }

  /* ── Light Mode ── */
  html.light .info-card {
    background: rgba(244, 244, 245, 0.94);
    border-color: rgba(0, 0, 0, 0.1);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.15);
  }
  html.light .info-title {
    color: #171717;
  }
  html.light #stat-distance {
    color: #171717 !important;
  }
  html.light .marker-label {
    background: rgba(244, 244, 245, 0.92) !important;
    border-color: rgba(20, 184, 166, 0.3) !important;
  }
  html.light .marker-label span {
    color: #0f766e !important;
  }

  /* ═══════════════════════════════════════════
     COLLAPSIBLE MOBILE INFO PANEL
     ═══════════════════════════════════════════ */
  @media (max-width: 767px) {
    #info-panel.is-collapsed #panel-expandable-body {
      display: none !important;
    }
    #info-panel.is-collapsed .info-card {
      padding-bottom: 0.5rem !important;
      padding-top: 0.5rem !important;
    }
  }
</style>

<script is:inline>
  // ═══════════════════════════════════════════════════════
  // TACTICAL MAP ENGINE — PIBOX ADDRESS LOCATOR & ROUTING
  // ═══════════════════════════════════════════════════════

  (function () {
    /** @type {L.Map | null} */
    let mapInstance = null;
    /** @type {L.TileLayer | null} */
    let currentTileLayer = null;
    /** @type {L.Marker | null} */
    let userMarker = null;
    /** @type {L.Polyline | null} */
    let connectionLine = null;
    /** @type {MutationObserver | null} */
    let themeObserver = null;

    // Sedes operativas de Diverpremier en Bogotá:
    // Sede 1: Álamos Norte (Cl. 71B # 100-38)
    // Sede 2: Ciudad Bachué (Cl. 88 # 95G-15)
    const BUNKERS = [
      {
        id: "alamos",
        tag: "Búnker Central",
        name: "Álamos Norte",
        label: "BÚNKER ÁLAMOS",
        address: "Cl. 71B # 100-38, Engativá, Bogotá",
        coords: [4.7026601, -74.1174237],
        gmaps: "https://www.google.com/maps/dir/?api=1&destination=4.7026601,-74.1174237",
        waze: "https://waze.com/ul?ll=4.7026601,-74.1174237&navigate=yes",
        color: "#2dd4bf",
      },
      {
        id: "bachue",
        tag: "Nueva Sede",
        name: "Ciudad Bachué",
        label: "BÚNKER BACHUÉ",
        address: "Cl. 88 # 95G-15, Engativá, Bogotá",
        coords: [4.716100, -74.103800],
        gmaps: "https://www.google.com/maps/dir/?api=1&destination=4.716100,-74.103800",
        waze: "https://waze.com/ul?ll=4.716100,-74.103800&navigate=yes",
        color: "#38bdf8",
      },
    ];

    let activeBunker = BUNKERS[0];
    const FLASH_RADIUS_METERS = 2500; // 2.5 KM
    const EXTENDED_RADIUS_METERS = 6000; // 6.0 KM

    const TILES = {
      dark: "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
      light: "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
    };

    function isLightMode() {
      return document.documentElement.classList.contains("light");
    }

    function getCurrentTileUrl() {
      return isLightMode() ? TILES.light : TILES.dark;
    }

    function swapTileLayer() {
      if (!mapInstance) return;
      if (currentTileLayer) {
        mapInstance.removeLayer(currentTileLayer);
      }
      currentTileLayer = L.tileLayer(getCurrentTileUrl(), {
        maxNativeZoom: 19,
        maxZoom: 19,
        attribution: "",
      }).addTo(mapInstance);
    }

    function createBunkerMarkerHtml(bunker) {
      const isAlamos = bunker.id === "alamos";
      const glowColor = isAlamos ? "bg-teal-400/40" : "bg-cyan-400/40";
      const ringColor = isAlamos ? "border-teal-400/40" : "border-cyan-400/40";
      const ringColor2 = isAlamos ? "border-teal-400/60" : "border-cyan-400/60";
      const dotColor = isAlamos ? "bg-teal-400 shadow-[0_0_20px_#2dd4bf]" : "bg-cyan-400 shadow-[0_0_20px_#38bdf8]";
      const borderLabel = isAlamos ? "border-teal-500/30" : "border-cyan-500/30";
      const textLabel = isAlamos ? "text-teal-400 drop-shadow-[0_0_5px_rgba(45,212,191,0.5)]" : "text-cyan-400 drop-shadow-[0_0_5px_rgba(56,189,248,0.5)]";

      return `
        <div class="relative flex items-center justify-center w-12 h-12 cursor-pointer">
          <div class="absolute w-full h-full ${glowColor} rounded-full blur-xl animate-pulse"></div>
          <div class="absolute w-24 h-24 border ${ringColor} rounded-full pulse-ring" style="animation-duration:3s"></div>
          <div class="absolute w-16 h-16 border ${ringColor2} rounded-full pulse-ring" style="animation-duration:2s;animation-delay:0.5s"></div>
          <div class="relative w-5 h-5 ${dotColor} rounded-full border border-white flex justify-center items-center">
            <div class="w-1.5 h-1.5 bg-white rounded-full"></div>
          </div>
          <div class="marker-label absolute mt-16 whitespace-nowrap px-3 py-1.5 glass-neon rounded-xl border ${borderLabel} bg-[#020617]/80 backdrop-blur-md">
            <span class="${textLabel} font-black text-[9px] uppercase tracking-widest">${bunker.label}</span>
          </div>
        </div>
      `;
    }

    function createUserMarkerHtml(label) {
      return `
        <div class="relative flex items-center justify-center w-10 h-10 cursor-grab active:cursor-grabbing">
          <div class="absolute w-full h-full bg-pink-500/30 rounded-full blur-lg animate-pulse"></div>
          <div class="relative w-4 h-4 bg-pink-500 rounded-full shadow-[0_0_15px_#ec4899] border-2 border-white flex justify-center items-center">
            <div class="w-1 h-1 bg-white rounded-full"></div>
          </div>
          <div class="marker-label absolute mt-14 whitespace-nowrap px-2.5 py-1 glass-neon rounded-lg border border-pink-500/40 bg-[#020617]/90 backdrop-blur-md shadow-lg">
            <span class="text-pink-400 font-black text-[8px] uppercase tracking-wider">${label || "TU UBICACIÓN"}</span>
          </div>
        </div>
      `;
    }

    // ─────────────────────────────────────────────────────────────
    // NORMALIZADOR DE DIRECCIONES COLOMBIANAS (ESTILO PIBOX)
    // ─────────────────────────────────────────────────────────────
    function normalizeColombianAddress(raw) {
      if (!raw) return "";
      let str = raw.trim().toLowerCase();

      // 1. Desacoplar complementos residenciales (Apto, Torre, Casa, etc.)
      str = str.replace(/\b(apto|apartamento|torre|tr|bloque|blq|int|interior|casa|cs|piso|local|lc|oficina|of|conjunto|conj)\b.*$/i, "");

      // 2. Normalizar tipo de vía
      str = str.replace(/\b(cll|cl|c\.|calle)\b/gi, "Calle");
      str = str.replace(/\b(cra|cr|kra|k\.|k|ak|carrera)\b/gi, "Carrera");
      str = str.replace(/\b(dg|diag|diagonal)\b/gi, "Diagonal");
      str = str.replace(/\b(tv|trans|trv|transversal)\b/gi, "Transversal");
      str = str.replace(/\b(av\s*cl|av\s*calle|ac)\b/gi, "Avenida Calle");
      str = str.replace(/\b(av\s*cra|av\s*carrera|ak)\b/gi, "Avenida Carrera");
      str = str.replace(/\b(av|avenida)\b/gi, "Avenida");

      // 3. Normalizar conectores (#, No., N°)
      str = str.replace(/\b(no\.|n°|no|num|numero)\b/gi, "#");
      str = str.replace(/([a-z0-9])#/gi, "$1 #");
      str = str.replace(/\s+/g, " ").trim();

      return str;
    }

    // ─────────────────────────────────────────────────────────────
    // CÁLCULO DE COBERTURA Y DISTANCIA
    // ─────────────────────────────────────────────────────────────
    function updateCoverage(lat, lng, addressLabel) {
      if (!mapInstance) return;

      const userPos = L.latLng(lat, lng);

      // Encontrar el búnker más cercano a la ubicación del usuario
      let nearestBunker = BUNKERS[0];
      let minDistanceMeters = Infinity;

      BUNKERS.forEach((b) => {
        const d = L.latLng(b.coords[0], b.coords[1]).distanceTo(userPos);
        if (d < minDistanceMeters) {
          minDistanceMeters = d;
          nearestBunker = b;
        }
      });

      const distanceKm = (minDistanceMeters / 1000).toFixed(1);

      // 1. Actualizar o crear marcador de usuario
      const userIcon = L.divIcon({
        className: "neon-pink-marker",
        html: createUserMarkerHtml(addressLabel || "TU UBICACIÓN"),
        iconSize: [40, 40],
        iconAnchor: [20, 20],
      });

      if (!userMarker) {
        userMarker = L.marker([lat, lng], {
          icon: userIcon,
          draggable: true,
        }).addTo(mapInstance);

        userMarker.on("drag", function (e) {
          const pos = e.target.getLatLng();
          updateCoverage(pos.lat, pos.lng, "ARRÁSTRAME A TU PUERTA");
        });
      } else {
        userMarker.setLatLng([lat, lng]);
        userMarker.setIcon(userIcon);
      }

      // 2. Línea táctica de conexión entre el Búnker más cercano y el Usuario
      if (connectionLine) {
        connectionLine.setLatLngs([nearestBunker.coords, [lat, lng]]);
      } else {
        connectionLine = L.polyline([nearestBunker.coords, [lat, lng]], {
          color: "#ec4899",
          weight: 2,
          dashArray: "6, 8",
          opacity: 0.85,
        }).addTo(mapInstance);
      }

      // 3. Actualizar UI del Panel de Cobertura
      const distEl = document.getElementById("stat-distance");
      const timeEl = document.getElementById("stat-time");
      const badgeEl = document.getElementById("coverage-badge");
      const noteEl = document.getElementById("coverage-note");
      const boxEl = document.getElementById("coverage-status-box");
      const waBtn = document.getElementById("btn-whatsapp-delivery");
      const waLabel = document.getElementById("btn-whatsapp-label");

      if (distEl) distEl.innerText = `${distanceKm} KM`;

      let estimatedMinutes = "15 - 25 MIN";
      let badgeText = "ZONA FLASH ⚡";
      let badgeClass = "text-teal-400 border-teal-400/40 bg-teal-400/10";
      let noteText = `🚀 ¡Ubicación en zona de entrega ultra-rápida desde ${nearestBunker.name}!`;

      if (minDistanceMeters <= FLASH_RADIUS_METERS) {
        estimatedMinutes = "15 - 25 MIN";
        badgeText = "ZONA FLASH ⚡";
        badgeClass = "text-teal-400 border-teal-400/40 bg-teal-400/10";
        noteText = `🚀 ¡Ubicación en zona de entrega ultra-rápida desde ${nearestBunker.name}!`;
        if (boxEl) boxEl.className = "p-3 rounded-2xl border border-teal-400/30 bg-teal-400/5 transition-all duration-300";
      } else if (minDistanceMeters <= EXTENDED_RADIUS_METERS) {
        estimatedMinutes = "30 - 45 MIN";
        badgeText = "ZONA EXTENDIDA 🛵";
        badgeClass = "text-amber-400 border-amber-400/40 bg-amber-400/10";
        noteText = `🛵 Cobertura extendida disponible desde ${nearestBunker.name} (Engativá y alrededores).`;
        if (boxEl) boxEl.className = "p-3 rounded-2xl border border-amber-400/30 bg-amber-400/5 transition-all duration-300";
      } else {
        estimatedMinutes = "CONSULTAR";
        badgeText = "FUERA DE COBERTURA ⚠️";
        badgeClass = "text-rose-400 border-rose-400/40 bg-rose-400/10";
        noteText = "⚠️ Estás fuera del radio habitual. Contáctanos por WhatsApp para validar envío especial.";
        if (boxEl) boxEl.className = "p-3 rounded-2xl border border-rose-400/30 bg-rose-400/5 transition-all duration-300";
      }

      if (timeEl) timeEl.innerText = estimatedMinutes;
      const miniPill = document.getElementById("stat-mini-pill");
      if (miniPill) {
        miniPill.innerText = `${distanceKm} KM • ${estimatedMinutes}`;
      }
      if (badgeEl) {
        badgeEl.innerText = badgeText;
        badgeEl.className = `text-[7.5px] sm:text-[8px] font-black uppercase tracking-wider px-2 py-0.5 rounded-full border ${badgeClass}`;
      }
      if (noteEl) noteEl.innerText = noteText;

      // 4. Actualizar link de WhatsApp con las coordenadas exactas y sede más cercana
      if (waBtn) {
        const mapsLink = `https://www.google.com/maps?q=${lat.toFixed(6)},${lng.toFixed(6)}`;
        const message = `Hola Diverpremier, verifiqué mi ubicación en el mapa: Distancia: ${distanceKm} km desde ${nearestBunker.name}. Mi punto exacto de entrega es: ${mapsLink}. ¿Tienen despacho disponible?`;
        waBtn.setAttribute("href", `https://wa.me/573114940503?text=${encodeURIComponent(message)}`);
      }
      if (waLabel) waLabel.innerText = `Pedir desde ${nearestBunker.name}`;
    }

    // ─────────────────────────────────────────────────────────────
    // GEOCODIFICADOR CON SESGO BOGOTÁ (NOMINATIM / OSM)
    // ─────────────────────────────────────────────────────────────
    async function searchAddress(query) {
      if (!query || query.trim().length < 3) return;

      const normalized = normalizeColombianAddress(query);
      const feedbackEl = document.getElementById("search-feedback");
      const normTextEl = document.getElementById("normalized-text");
      const btnSearch = document.getElementById("btn-search");

      if (feedbackEl) feedbackEl.classList.remove("hidden");
      if (normTextEl) normTextEl.innerText = `🔍 Buscando: "${normalized}"`;
      if (btnSearch) btnSearch.innerText = "...";

      try {
        const searchQuery = `${normalized}, Bogotá, Colombia`;
        const url = `https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(
          searchQuery
        )}&viewbox=-74.25,4.85,-74.00,4.45&bounded=1&countrycodes=co&limit=1`;

        const res = await fetch(url, { headers: { "Accept-Language": "es" } });
        const results = await res.json();

        if (results && results.length > 0) {
          const item = results[0];
          const lat = parseFloat(item.lat);
          const lng = parseFloat(item.lon);

          if (normTextEl) normTextEl.innerText = `📍 Ubicado: ${normalized}`;
          updateCoverage(lat, lng, normalized.toUpperCase());

          mapInstance.flyTo([lat, lng], 15.5, {
            duration: 1.2,
          });
        } else {
          if (normTextEl) normTextEl.innerText = `⚠️ No exacto. Toca el mapa para fijar tu pin.`;
        }
      } catch (err) {
        console.error("Geocoding error:", err);
        if (normTextEl) normTextEl.innerText = `⚠️ Error de red. Puedes tocar el mapa manualmente.`;
      } finally {
        if (btnSearch) btnSearch.innerText = "Buscar";
      }
    }

    // ─────────────────────────────────────────────────────────────
    // INICIALIZACIÓN DEL MAPA
    // ─────────────────────────────────────────────────────────────
    function initMap() {
      const container = document.getElementById("tactical-map");
      if (!container) return;

      // Esperar a que la librería Leaflet (L) esté lista desde el CDN
      if (typeof L === "undefined") {
        setTimeout(initMap, 100);
        return;
      }

      if (mapInstance) {
        themeObserver?.disconnect();
        mapInstance.remove();
        mapInstance = null;
        currentTileLayer = null;
        userMarker = null;
        connectionLine = null;
      }

      if (container._leaflet_id) {
        container._leaflet_id = null;
        container.innerHTML = "";
      }

      // Centro inicial entre Búnker Álamos y Búnker Bachué
      const INITIAL_CENTER = [
        (BUNKERS[0].coords[0] + BUNKERS[1].coords[0]) / 2,
        (BUNKERS[0].coords[1] + BUNKERS[1].coords[1]) / 2,
      ];

      // Crear mapa centrado en la zona operativa
      mapInstance = L.map("tactical-map", {
        zoomControl: false,
        attributionControl: false,
        maxZoom: 19,
        minZoom: 11,
      }).setView(INITIAL_CENTER, 14);

      currentTileLayer = L.tileLayer(getCurrentTileUrl(), {
        maxNativeZoom: 19,
        maxZoom: 19,
        attribution: "",
      }).addTo(mapInstance);

      // Asegurar que Leaflet calcule dimensiones reales del viewport
      setTimeout(function () {
        if (mapInstance) {
          mapInstance.invalidateSize();
        }
      }, 250);

      // Marcadores y Círculos de Cobertura para cada Búnker
      BUNKERS.forEach((bunker) => {
        const bunkerIcon = L.divIcon({
          className: "neon-bunker-marker",
          html: createBunkerMarkerHtml(bunker),
          iconSize: [48, 48],
          iconAnchor: [24, 24],
        });

        L.marker(bunker.coords, { icon: bunkerIcon })
          .addTo(mapInstance)
          .on("click", () => selectBunker(bunker.id));

        // Círculo de Zona Flash (2.5 km)
        L.circle(bunker.coords, {
          color: bunker.color,
          fillColor: bunker.color,
          fillOpacity: 0.06,
          weight: 1.5,
          dashArray: "5, 10",
          radius: FLASH_RADIUS_METERS,
        }).addTo(mapInstance);

        // Círculo de Zona Extendida (6 km)
        L.circle(bunker.coords, {
          color: "#f59e0b",
          fillColor: "#f59e0b",
          fillOpacity: 0.02,
          weight: 1,
          dashArray: "4, 8",
          radius: EXTENDED_RADIUS_METERS,
        }).addTo(mapInstance);
      });

      // ── Conmutador de Sedes / Búnkers ──
      function selectBunker(bunkerId) {
        const b = BUNKERS.find((item) => item.id === bunkerId);
        if (!b) return;
        activeBunker = b;

        // Actualizar diseño de pestañas
        document.querySelectorAll(".bunker-tab").forEach((tab) => {
          if (tab.getAttribute("data-bunker-id") === bunkerId) {
            tab.className =
              "bunker-tab active flex-1 py-1.5 px-2 rounded-xl text-[9px] font-black uppercase tracking-wider transition-all text-white bg-teal-500/20 border border-teal-500/40 shadow-sm cursor-pointer";
          } else {
            tab.className =
              "bunker-tab flex-1 py-1.5 px-2 rounded-xl text-[9px] font-black uppercase tracking-wider transition-all text-slate-400 hover:text-white border border-transparent cursor-pointer";
          }
        });

        // Actualizar datos del header informativo
        const tagEl = document.getElementById("bunker-tag");
        const nameEl = document.getElementById("bunker-name");
        const addrEl = document.getElementById("bunker-address");
        const gmapsLink = document.getElementById("link-bunker-gmaps");
        const wazeLink = document.getElementById("link-bunker-waze");

        if (tagEl) tagEl.innerText = b.tag;
        if (nameEl) nameEl.innerText = b.name;
        if (addrEl) addrEl.innerText = b.address;
        if (gmapsLink) gmapsLink.href = b.gmaps;
        if (wazeLink) wazeLink.href = b.waze;

        if (mapInstance) {
          mapInstance.flyTo(b.coords, 15, { duration: 1.0 });
        }
      }

      document.querySelectorAll(".bunker-tab").forEach((btn) => {
        btn.addEventListener("click", () => {
          const id = btn.getAttribute("data-bunker-id");
          if (id) selectBunker(id);
        });
      });

      // ── Evento Click en el mapa para posicionar el Pin ──
      mapInstance.on("click", function (e) {
        updateCoverage(e.latlng.lat, e.latlng.lng, "TU PIN CONFIRMADO");
      });

      // ── Eventos del Buscador de Direcciones ──
      const addressForm = document.getElementById("address-form");
      const addressInput = document.getElementById("address-input");
      const btnGps = document.getElementById("btn-gps");
      const btnReset = document.getElementById("btn-reset-map");

      if (addressForm && addressInput) {
        addressForm.addEventListener("submit", function (e) {
          e.preventDefault();
          searchAddress(addressInput.value);
        });
      }

      // ── GPS Geolocation ──
      if (btnGps) {
        btnGps.addEventListener("click", function () {
          if (!navigator.geolocation) {
            alert("Tu navegador no soporta geolocalización GPS.");
            return;
          }
          btnGps.classList.add("animate-spin");
          navigator.geolocation.getCurrentPosition(
            function (pos) {
              btnGps.classList.remove("animate-spin");
              const lat = pos.coords.latitude;
              const lng = pos.coords.longitude;
              updateCoverage(lat, lng, "MI POSICIÓN GPS");
              mapInstance.flyTo([lat, lng], 16, { duration: 1.2 });
            },
            function (err) {
              btnGps.classList.remove("animate-spin");
              alert("No pudimos acceder a tu GPS. Por favor escribe tu dirección o toca el mapa.");
            },
            { enableHighAccuracy: true, timeout: 10000 }
          );
        });
      }

      // ── Botón Reset / Centrar Búnker Activo ──
      if (btnReset) {
        btnReset.addEventListener("click", function () {
          if (mapInstance && activeBunker) {
            mapInstance.flyTo(activeBunker.coords, 15, { duration: 1 });
          }
        });
      }

      // ── Mobile Grabber Toggle ──
      const grabberBtn = document.getElementById("mobile-panel-grabber");
      const infoPanel = document.getElementById("info-panel");
      const grabberStatusText = document.getElementById("grabber-status-text");

      if (grabberBtn && infoPanel) {
        grabberBtn.addEventListener("click", function (e) {
          e.stopPropagation();
          const isCollapsed = infoPanel.classList.toggle("is-collapsed");
          if (grabberStatusText) {
            grabberStatusText.innerText = isCollapsed
              ? "Tocar para expandir detalles"
              : "Tocar para contraer";
          }
        });
      }

      // ── Theme Observer ──
      themeObserver = new MutationObserver(function (mutations) {
        for (const mutation of mutations) {
          if (mutation.attributeName === "class") {
            swapTileLayer();
          }
        }
      });
      themeObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["class"],
      });
    }

    if (document.readyState === "complete" || document.readyState === "interactive") {
      initMap();
    }
    document.addEventListener("DOMContentLoaded", initMap);
    document.addEventListener("astro:page-load", initMap);
  })();
</script>
