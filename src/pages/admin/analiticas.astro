---
export const prerender = false;
import AdminLayout from "@layouts/AdminLayout.astro";
import { supabaseAdmin } from "@lib/supabase";
import { formatCOP } from "@lib/formatters";

// 1. Fetch live metrics from Supabase in parallel
const [
  { data: productsRaw },
  { data: categoriesRaw },
  { data: ordersRaw }
] = await Promise.all([
  supabaseAdmin.from("products").select("id, name, price, stock_quantity, category_id"),
  supabaseAdmin.from("categories").select("id, name"),
  supabaseAdmin.from("orders").select("id, total_price, status, created_at")
]);

const products = productsRaw || [];
const categories = categoriesRaw || [];
const orders = ordersRaw || [];

// 2. Compute Financial & Order Metrics
const verifiedOrders = orders.filter(o => o.status === "verified");
const pendingOrders = orders.filter(o => o.status === "pending_payment" || o.status === "verification_pending");
const totalSales = verifiedOrders.reduce((acc, o) => acc + (Number(o.total_price) || 0), 0);
const averageTicket = verifiedOrders.length > 0 ? Math.round(totalSales / verifiedOrders.length) : 0;
const conversionRate = orders.length > 0 ? Math.round((verifiedOrders.length / orders.length) * 100) : 0;

// 3. Compute Inventory Metrics
const totalProducts = products.length;
const totalInventoryValue = products.reduce((acc, p) => acc + (Number(p.price || 0) * Number(p.stock_quantity || 0)), 0);
const totalUnitsInStock = products.reduce((acc, p) => acc + Number(p.stock_quantity || 0), 0);

const inStockCount = products.filter(p => Number(p.stock_quantity || 0) > 10).length;
const lowStockCount = products.filter(p => Number(p.stock_quantity || 0) > 0 && Number(p.stock_quantity || 0) <= 10).length;
const outOfStockCount = products.filter(p => Number(p.stock_quantity || 0) === 0).length;

// 4. Categories Distribution
const categoryMap = new Map<string, string>();
categories.forEach(c => categoryMap.set(c.id, c.name));

const categoryCounts: Record<string, { count: number; totalValue: number }> = {};
products.forEach(p => {
  const catName = (p.category_id && categoryMap.get(p.category_id)) || "Sin Categoría";
  if (!categoryCounts[catName]) {
    categoryCounts[catName] = { count: 0, totalValue: 0 };
  }
  categoryCounts[catName].count += 1;
  categoryCounts[catName].totalValue += (Number(p.price || 0) * Number(p.stock_quantity || 0));
});

const topCategories = Object.entries(categoryCounts)
  .map(([name, data]) => ({ name, ...data }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 6);

const maxCategoryCount = topCategories.length > 0 ? topCategories[0].count : 1;
---

<AdminLayout title="Analíticas - Diverpremier Admin">
  <div class="max-w-6xl mx-auto space-y-10">

    <!-- Header -->
    <header class="flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <span class="w-1.5 h-1.5 rounded-full bg-teal-500 animate-pulse"></span>
          <span class="text-xs font-bold text-teal-500/70 uppercase tracking-[0.2em]">Inteligencia Operativa</span>
        </div>
        <h1 class="text-3xl md:text-4xl font-black text-white tracking-tight">Analíticas del Búnker</h1>
        <p class="text-neutral-500 mt-1 font-medium text-sm md:text-base">
          Métricas clave de rendimiento financiero, stock e inventario en tiempo real.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <button onclick="window.location.reload()" class="btn-secondary text-xs py-2.5 px-4 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></svg>
          Actualizar Datos
        </button>
      </div>
    </header>

    <!-- Top KPI Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">
      <!-- Total Ventas -->
      <div class="rounded-3xl p-6 border border-teal-500/20 bg-teal-500/10 backdrop-blur-sm relative overflow-hidden">
        <p class="text-[10px] font-bold text-teal-400 uppercase tracking-widest mb-3">Facturación Verificada</p>
        <h2 class="text-3xl font-black text-white tracking-tight">{formatCOP(totalSales)}</h2>
        <p class="text-xs text-teal-300/70 mt-2 font-mono">{verifiedOrders.length} pedidos liquidados</p>
      </div>

      <!-- Ticket Promedio -->
      <div class="rounded-3xl p-6 border border-white/10 bg-white/5 backdrop-blur-sm relative overflow-hidden">
        <p class="text-[10px] font-bold text-neutral-400 uppercase tracking-widest mb-3">Ticket Promedio</p>
        <h2 class="text-3xl font-black text-white tracking-tight">{formatCOP(averageTicket)}</h2>
        <p class="text-xs text-neutral-400 mt-2 font-mono">Por orden verificada</p>
      </div>

      <!-- Valor Inventario -->
      <div class="rounded-3xl p-6 border border-emerald-500/20 bg-emerald-500/10 backdrop-blur-sm relative overflow-hidden">
        <p class="text-[10px] font-bold text-emerald-400 uppercase tracking-widest mb-3">Valor de Inventario</p>
        <h2 class="text-3xl font-black text-white tracking-tight">{formatCOP(totalInventoryValue)}</h2>
        <p class="text-xs text-emerald-300/70 mt-2 font-mono">{totalUnitsInStock} unidades en almacén</p>
      </div>

      <!-- Tasa de Verificación -->
      <div class="rounded-3xl p-6 border border-amber-500/20 bg-amber-500/10 backdrop-blur-sm relative overflow-hidden">
        <p class="text-[10px] font-bold text-amber-400 uppercase tracking-widest mb-3">Efectividad de Órdenes</p>
        <h2 class="text-3xl font-black text-white tracking-tight">{conversionRate}%</h2>
        <p class="text-xs text-amber-300/70 mt-2 font-mono">{pendingOrders.length} pedidos pendientes</p>
      </div>
    </div>

    <!-- Main Grid: Stock Health + Category Breakdown -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <!-- Salud del Inventario -->
      <section class="rounded-3xl bg-neutral-900/40 border border-white/5 p-6 md:p-8 backdrop-blur-md space-y-6">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="text-xl font-bold text-white tracking-tight">Estado de Existencias</h3>
            <p class="text-sm text-neutral-500 mt-1">Disponibilidad total: {totalProducts} productos catalogados</p>
          </div>
          <span class="px-3 py-1 rounded-full bg-white/5 border border-white/10 text-[10px] font-mono text-teal-400">
            AUDITORÍA EN VIVO
          </span>
        </div>

        <!-- Progress Bar Visual -->
        <div class="w-full h-4 rounded-full bg-neutral-800 overflow-hidden flex">
          <div style={`width: ${(inStockCount / totalProducts) * 100}%`} class="bg-teal-500 h-full transition-all duration-700" title="Disponible"></div>
          <div style={`width: ${(lowStockCount / totalProducts) * 100}%`} class="bg-amber-500 h-full transition-all duration-700" title="Bajo Stock"></div>
          <div style={`width: ${(outOfStockCount / totalProducts) * 100}%`} class="bg-red-500 h-full transition-all duration-700" title="Agotado"></div>
        </div>

        <!-- Detailed Cards -->
        <div class="grid grid-cols-3 gap-3">
          <div class="p-4 rounded-2xl bg-teal-500/10 border border-teal-500/20 text-center">
            <p class="text-[10px] font-bold text-teal-400 uppercase tracking-wider mb-1">Disponible</p>
            <p class="text-2xl font-black text-white">{inStockCount}</p>
            <p class="text-[10px] text-teal-500/70 font-mono mt-1">> 10 unidades</p>
          </div>

          <div class="p-4 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-center">
            <p class="text-[10px] font-bold text-amber-400 uppercase tracking-wider mb-1">Bajo Stock</p>
            <p class="text-2xl font-black text-white">{lowStockCount}</p>
            <p class="text-[10px] text-amber-500/70 font-mono mt-1">1 - 10 unidades</p>
          </div>

          <div class="p-4 rounded-2xl bg-red-500/10 border border-red-500/20 text-center">
            <p class="text-[10px] font-bold text-red-400 uppercase tracking-wider mb-1">Agotado</p>
            <p class="text-2xl font-black text-white">{outOfStockCount}</p>
            <p class="text-[10px] text-red-500/70 font-mono mt-1">0 unidades</p>
          </div>
        </div>

        <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/5 flex items-center justify-between text-xs text-neutral-400 font-mono">
          <span>Unidades Totales Físicas en Bodega</span>
          <span class="text-white font-bold">{totalUnitsInStock.toLocaleString("es-CO")} unds.</span>
        </div>
      </section>

      <!-- Distribución por Categorías -->
      <section class="rounded-3xl bg-neutral-900/40 border border-white/5 p-6 md:p-8 backdrop-blur-md space-y-6">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="text-xl font-bold text-white tracking-tight">Top Categorías</h3>
            <p class="text-sm text-neutral-500 mt-1">Mayor concentración de catálogo</p>
          </div>
          <a href="/admin/inventario" class="text-xs font-bold text-teal-500 hover:text-teal-400 transition-colors uppercase tracking-widest">
            Ver Inventario
          </a>
        </div>

        <div class="space-y-4">
          {topCategories.map(cat => {
            const percentage = Math.round((cat.count / maxCategoryCount) * 100);
            return (
              <div class="space-y-1.5">
                <div class="flex items-center justify-between text-xs">
                  <span class="font-bold text-neutral-200">{cat.name}</span>
                  <div class="flex items-center gap-3 font-mono">
                    <span class="text-neutral-400">{cat.count} prods.</span>
                    <span class="text-teal-400 font-medium">{formatCOP(cat.totalValue)}</span>
                  </div>
                </div>
                <div class="w-full h-2 rounded-full bg-white/5 overflow-hidden">
                  <div 
                    style={`width: ${percentage}%`} 
                    class="h-full bg-gradient-to-r from-teal-500 to-emerald-400 rounded-full transition-all duration-500"
                  ></div>
                </div>
              </div>
            );
          })}
        </div>
      </section>
    </div>

    <!-- Pedidos y Pipeline Operativo -->
    <section class="rounded-3xl bg-neutral-900/40 border border-white/5 p-6 md:p-8 backdrop-blur-md">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h3 class="text-xl font-bold text-white tracking-tight">Pipeline de Pedidos</h3>
          <p class="text-sm text-neutral-500 mt-1">Desglose del embudo de ventas y verificación</p>
        </div>
        <a href="/admin/pedidos" class="text-xs font-bold text-teal-500 hover:text-teal-400 transition-colors uppercase tracking-widest">
          Gestionar Pedidos
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="p-5 rounded-2xl bg-amber-500/5 border border-amber-500/20">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold text-amber-400 uppercase tracking-widest">Pago Pendiente</span>
            <span class="text-amber-400 text-lg font-black">{orders.filter(o => o.status === 'pending_payment').length}</span>
          </div>
          <p class="text-xs text-neutral-400">Clientes con checkout generado esperando confirmación.</p>
        </div>

        <div class="p-5 rounded-2xl bg-orange-500/5 border border-orange-500/20">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold text-orange-400 uppercase tracking-widest">Verificando Pago</span>
            <span class="text-orange-400 text-lg font-black">{orders.filter(o => o.status === 'verification_pending').length}</span>
          </div>
          <p class="text-xs text-neutral-400">Comprobantes subidos o en revisión por el cajero/búnker.</p>
        </div>

        <div class="p-5 rounded-2xl bg-teal-500/5 border border-teal-500/20">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold text-teal-400 uppercase tracking-widest">Verificados</span>
            <span class="text-teal-400 text-lg font-black">{verifiedOrders.length}</span>
          </div>
          <p class="text-xs text-neutral-400">Pagos aprobados, stock descontado y despacho autorizado.</p>
        </div>
      </div>
    </section>

  </div>
</AdminLayout>
