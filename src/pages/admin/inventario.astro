          </div>

          <input type="hidden" id="edit-image-url" name="image_url" />

          <div class="flex items-center gap-4 p-3 rounded-2xl bg-white/[0.03] border border-white/10">
            <div class="relative w-16 h-16 rounded-xl bg-black/40 border border-white/10 overflow-hidden flex-shrink-0 flex items-center justify-center">
              <img id="edit-image-preview" src="/images/products/cerveza.png" alt="Preview" class="w-full h-full object-contain p-1" />
              <div id="image-upload-spinner" class="hidden absolute inset-0 bg-black/70 flex items-center justify-center">
                <svg class="animate-spin h-5 w-5 text-teal-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
              </div>
            </div>

            <div class="flex-1 min-w-0">
              <input type="file" id="edit-image-file" accept="image/*" class="hidden" />
              <button type="button" id="btn-trigger-image-upload" class="btn-secondary text-xs py-2 px-3 w-full flex items-center justify-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" x2="12" y1="3" y2="15"></line></svg>
                <span>Cargar Nueva Foto</span>
              </button>
              <p class="text-[9px] text-neutral-500 font-mono mt-1 truncate">Se convertirá y optimizará automáticamente a .webp</p>
            </div>
          </div>
        </div>

        <div class="space-y-2">
          <label class="text-[10px] font-bold text-neutral-500 uppercase tracking-widest ml-1">Categoría de Búnker</label>
          <select id="edit-category" name="category_id" class="input-bunker appearance-none cursor-pointer">
            {categories?.map(cat => (
              <option value={cat.id}>{cat.name}</option>
            ))}
          </select>
        </div>

        <div class="flex gap-4 pt-4">
          <button type="button" id="cancel-edit" class="btn-secondary flex-1">Cancelar</button>
          <button type="submit" class="btn-primary flex-1">Guardar Cambios</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ➕ MODAL DE CREAR PRODUCTO (BUNKER STYLE) -->
  <div id="add-modal" class="fixed inset-0 z-[100] flex items-center justify-center p-0 md:p-4 bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-all duration-300">
    <div class="glass-neon w-full h-full md:h-auto md:max-w-lg rounded-none md:rounded-[2.5rem] p-6 md:p-10 border-white/10 relative transform scale-95 transition-all duration-300 overflow-y-auto" id="add-modal-content">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h3 class="text-2xl font-black text-white tracking-tight">Añadir Nuevo Producto</h3>
          <p class="text-xs text-teal-400 font-mono mt-1 uppercase tracking-widest">Alta en Catálogo del Búnker</p>
        </div>
        <button id="close-add-modal" class="p-2 rounded-xl hover:bg-white/5 text-neutral-500 hover:text-white transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>

      <form id="add-form" class="space-y-6">
        <div class="space-y-2">
          <label class="text-[10px] font-bold text-neutral-500 uppercase tracking-widest ml-1">Nombre del Producto</label>
          <input type="text" id="add-name" name="name" placeholder="Ej: Ginebra Bulldog 750ml" class="input-bunker" required />
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-2">
            <label class="text-[10px] font-bold text-neutral-500 uppercase tracking-widest ml-1">Precio (COP)</label>
            <input type="text" id="add-price" name="price" class="input-bunker font-mono" placeholder="$ 0" required />
          </div>
          <div class="space-y-2">
            <label class="text-[10px] font-bold text-neutral-500 uppercase tracking-widest ml-1">Stock Inicial</label>
            <input type="number" id="add-stock" name="stock_quantity" class="input-bunker font-mono" placeholder="0" min="0" required />
          </div>
        </div>

        <!-- 📸 GESTIÓN DE IMAGEN (.WEBP AUTOMÁTICO) -->
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <label class="text-[10px] font-bold text-neutral-500 uppercase tracking-widest ml-1">Fotografía del Producto</label>
            <span class="text-[9px] font-mono text-teal-400 uppercase tracking-wider bg-teal-500/10 px-2 py-0.5 rounded-md border border-teal-500/20">Pipeline .WEBP Activo</span>
          </div>

          <input type="hidden" id="add-image-url" name="image_url" />

          <div class="flex items-center gap-4 p-3 rounded-2xl bg-white/[0.03] border border-white/10">
            <div class="relative w-16 h-16 rounded-xl bg-black/40 border border-white/10 overflow-hidden flex-shrink-0 flex items-center justify-center">
              <img id="add-image-preview" src="/images/products/cerveza.png" alt="Preview" class="w-full h-full object-contain p-1" />
              <div id="add-image-spinner" class="hidden absolute inset-0 bg-black/70 flex items-center justify-center">
                <svg class="animate-spin h-5 w-5 text-teal-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg>
              </div>
            </div>

            <div class="flex-1 min-w-0">
              <input type="file" id="add-image-file" accept="image/*" class="hidden" />
              <button type="button" id="btn-trigger-add-image" class="btn-secondary text-xs py-2 px-3 w-full flex items-center justify-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" x2="12" y1="3" y2="15"></line></svg>
                <span>Cargar Foto</span>
              </button>
              <p class="text-[9px] text-neutral-500 font-mono mt-1 truncate">Se convertirá automáticamente a .webp</p>
            </div>
          </div>
        </div>

        <div class="space-y-2">
          <label class="text-[10px] font-bold text-neutral-500 uppercase tracking-widest ml-1">Categoría de Búnker</label>
          <select id="add-category" name="category_id" class="input-bunker appearance-none cursor-pointer" required>
            <option value="" disabled selected>Selecciona una categoría</option>
            {categories?.map(cat => (
              <option value={cat.id}>{cat.name}</option>
            ))}
          </select>
        </div>

        <div class="space-y-2">
          <label class="text-[10px] font-bold text-neutral-500 uppercase tracking-widest ml-1">Descripción / Presentación (Opcional)</label>
          <input type="text" id="add-description" name="description" placeholder="Ej: Botella de vidrio 750ml" class="input-bunker" />
        </div>

        <div class="flex gap-4 pt-4">
          <button type="button" id="cancel-add" class="btn-secondary flex-1">Cancelar</button>
          <button type="submit" id="submit-add-btn" class="btn-primary flex-1">Crear Producto</button>
        </div>
      </form>
    </div>
  </div>

  <!-- 🔔 NOTIFICACIÓN DE ÉXITO (BUNKER STYLE) -->
  <div id="toast" class="fixed bottom-10 right-10 z-[100] translate-x-[150%] transition-transform duration-500">
    <div class="glass-neon px-6 py-4 rounded-2xl border-teal-500/30 flex items-center gap-4">
      <div class="w-8 h-8 rounded-full bg-teal-500/20 flex items-center justify-center text-teal-400">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
      </div>
      <div>
        <p class="text-sm font-bold text-white">Inventario Actualizado</p>
        <p class="text-[10px] text-teal-500/70 font-mono uppercase tracking-wider">Sync Completa con el Búnker</p>
      </div>
    </div>
  </div>
</AdminLayout>

<div id="admin-data-store" class="hidden" data-categories={JSON.stringify(categories)}></div>

<script>
  import { formatCOP, extractNumber } from "@lib/formatters";

  // --- LÓGICA DE FILTRADO (NITRO STYLE) ---
  const chips = document.querySelectorAll(".filter-chip");
  const sections = document.querySelectorAll(".category-section");
  const emptyState = document.getElementById("empty-state");

  chips.forEach(chip => {
    chip.addEventListener("click", () => {
      const filter = chip.getAttribute("data-filter");
      
      // 1. Update UI (Chips State)
      chips.forEach(c => c.classList.remove("active"));
      chip.classList.add("active");

      // 2. Filter Sections
      let visibleCount = 0;
      const lowerFilter = filter?.toLowerCase() || "";
      sections.forEach(section => {
        const category = section.getAttribute("data-category");
        const lowerCategory = category?.toLowerCase() || "";
        const isVisible = lowerFilter === "all" || lowerCategory === lowerFilter;
        
        if (isVisible) {
          section.classList.remove("hidden");
          // Reset animations to trigger them again
          section.classList.remove("animate-in", "fade-in", "slide-in-from-bottom-4");
          void (section as HTMLElement).offsetWidth; // Force reflow
          section.classList.add("animate-in", "fade-in", "zoom-in-95", "duration-500");
          visibleCount++;
        } else {
          section.classList.add("hidden");
        }
      });

      // 3. Handle Empty State
      if (visibleCount === 0) {
        emptyState?.classList.remove("hidden");
      } else {
        emptyState?.classList.add("hidden");
      }
    });
  });

  const fileInput = document.getElementById("csv-upload");
  const uploadBtn = document.getElementById("btn-bulk-upload") as HTMLButtonElement | null;

  uploadBtn?.addEventListener("click", () => fileInput?.click());

  fileInput?.addEventListener("change", async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = async (event) => {
      const text = event.target?.result as string;
      if (!text) return;
      const rows = text.split(/\r?\n/).filter((line) => line.trim() !== "");
      const separator = rows[0].includes(";") ? ";" : ",";
      const dataRows = rows.slice(1);

      const productsToInsert = dataRows
        .map((line) => {
          const row = line.split(separator);
          if (row.length < 5) return null;

          const csvCategory = row[0]?.trim() || "";
          const csvName = row[1]?.trim() || "";
          const csvPresentation = row[2]?.trim() || "";
          const csvPrice = row[3]?.trim() || "0";
          const csvStock = row[4]?.trim() || "0";

          return {
            name: `${csvName} ${csvPresentation}`.trim(),
            description: `Formato: ${csvPresentation}`,
            price: extractNumber(csvPrice),
            stock_quantity: extractNumber(csvStock),
            category_name: csvCategory, // Enviamos el nombre para que el búnker lo gestione
            is_active: true,
          };
        })
        .filter((p) => p !== null);

      if (productsToInsert.length > 0) {
        if (uploadBtn) {
          uploadBtn.disabled = true;
          uploadBtn.innerText = "Sincronizando...";
        }
        
        try {
          const response = await fetch("/api/bulk-products", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(productsToInsert),
          });

          if (response.ok) {
            window.location.reload();
          } else {
            alert("Error en el búnker de datos. Revisa la consola.");
          }
        } catch (err) {
          console.error(err);
          alert("Error de conexión al cargar el CSV.");
        } finally {
          if (uploadBtn) {
            uploadBtn.disabled = false;
            uploadBtn.innerText = "Carga Masiva (CSV)";
          }
        }
      }
    };
    reader.readAsText(file);
  });

  // --- CARGA MASIVA DE FOTOS AUTO-VINCULADAS A PRODUCTOS (.WEBP) ---
  const bulkImagesInput = document.getElementById("bulk-images-upload") as HTMLInputElement | null;
  const bulkImagesBtn = document.getElementById("btn-bulk-images") as HTMLButtonElement | null;

  bulkImagesBtn?.addEventListener("click", () => bulkImagesInput?.click());

  bulkImagesInput?.addEventListener("change", async () => {
    const files = bulkImagesInput.files;
    if (!files || files.length === 0) return;

    if (bulkImagesBtn) {
      bulkImagesBtn.disabled = true;
      bulkImagesBtn.innerText = `Sincronizando ${files.length} fotos a .WebP...`;
    }

    try {
      const formData = new FormData();
      for (let i = 0; i < files.length; i++) {
        formData.append("files", files[i]);
      }

      const response = await fetch("/api/bulk-upload-images", {
        method: "POST",
        body: formData,
      });

      const result = await response.json();
      if (response.ok && result.success) {
        alert(`✅ Sincronización masiva exitosa:\n\n${result.matchedCount} productos vinculados a sus nuevas fotos .WebP.\n${result.unmatchedCount > 0 ? `(${result.unmatchedCount} fotos no coincidieron con el catálogo)` : ""}`);
        window.location.reload();
      } else {
        alert("Error en la carga masiva de fotos: " + (result.error || ""));
      }
    } catch (err) {
      console.error(err);
      alert("Error de conexión durante la subida masiva de imágenes.");
    } finally {
      if (bulkImagesBtn) {
        bulkImagesBtn.disabled = false;
        bulkImagesBtn.innerHTML = `
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mr-1 text-teal-400">
            <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
            <circle cx="9" cy="9" r="2"></circle>
            <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
          </svg>
          Fotos Masivas (.WebP)
        `;
      }
    }
  });

  // --- LÓGICA DEL MODAL DE EDICIÓN ---
  const modal = document.getElementById("edit-modal");
  const modalContent = document.getElementById("modal-content");
  const editForm = document.getElementById("edit-form");
  const closeBtn = document.getElementById("close-modal");
  const cancelBtn = document.getElementById("cancel-edit");
  const toast = document.getElementById("toast");

  const priceInput = document.getElementById("edit-price");
  priceInput?.addEventListener("input", (e) => {
    const target = e.target as HTMLInputElement;
    target.value = formatCOP(target.value);
  });

  const openModal = (product: any) => {
    const editId = document.getElementById("edit-id") as HTMLInputElement | null;
    const editName = document.getElementById("edit-name") as HTMLInputElement | null;
    const editPrice = document.getElementById("edit-price") as HTMLInputElement | null;
    const editStock = document.getElementById("edit-stock") as HTMLInputElement | null;
    const editCategory = document.getElementById("edit-category") as HTMLSelectElement | null;
    const editImageUrl = document.getElementById("edit-image-url") as HTMLInputElement | null;
    const editImagePreview = document.getElementById("edit-image-preview") as HTMLImageElement | null;

    if (editId) editId.value = product.id;
    if (editName) editName.value = product.name;
    if (editPrice) editPrice.value = formatCOP(product.price);
    if (editStock) editStock.value = product.stock;
    if (editCategory) editCategory.value = product.category_id;
    if (editImageUrl) editImageUrl.value = product.image_url || "";
    if (editImagePreview) editImagePreview.src = product.image_url || "/images/products/cerveza.png";

    modal?.classList.remove("opacity-0", "pointer-events-none");
    modalContent?.classList.remove("scale-95");
  };

  // 📸 Lógica de Subida y Procesamiento a WebP
  const imageFileInput = document.getElementById("edit-image-file") as HTMLInputElement | null;
  const triggerImageBtn = document.getElementById("btn-trigger-image-upload");
  const editImagePreview = document.getElementById("edit-image-preview") as HTMLImageElement | null;
  const editImageUrl = document.getElementById("edit-image-url") as HTMLInputElement | null;
  const imageSpinner = document.getElementById("image-upload-spinner");

  triggerImageBtn?.addEventListener("click", () => imageFileInput?.click());

  imageFileInput?.addEventListener("change", async () => {
    const file = imageFileInput.files?.[0];
    if (!file) return;

    const localUrl = URL.createObjectURL(file);
    if (editImagePreview) editImagePreview.src = localUrl;
    imageSpinner?.classList.remove("hidden");

    try {
      const formData = new FormData();
      formData.append("file", file);
      const prodName = (document.getElementById("edit-name") as HTMLInputElement)?.value || "product";
      formData.append("name", prodName);

      const res = await fetch("/api/upload-image", {
        method: "POST",
        body: formData,
      });

      const data = await res.json();
      if (res.ok && data.imageUrl) {
        if (editImageUrl) editImageUrl.value = data.imageUrl;
        if (editImagePreview) editImagePreview.src = data.imageUrl;
      } else {
        alert("Error al procesar la imagen a .webp: " + (data.error || ""));
      }
    } catch (err) {
      console.error(err);
      alert("Error de conexión al procesar la imagen.");
    } finally {
      imageSpinner?.classList.add("hidden");
    }
  });

  const closeModal = () => {
    modal?.classList.add("opacity-0", "pointer-events-none");
    modalContent?.classList.add("scale-95");
  };

  const showToast = () => {
    if (!toast) return;
    toast.classList.remove("translate-x-[150%]");
    setTimeout(() => toast?.classList.add("translate-x-[150%]"), 3000);
  };

  // Event Listeners para botones de edición
  document.querySelectorAll(".edit-product-btn").forEach(btn => {
    btn.addEventListener("click", () => {
      const dataProduct = btn.getAttribute("data-product");
      if (!dataProduct) return;
      const product = JSON.parse(dataProduct);
      openModal(product);
    });
  });

  closeBtn?.addEventListener("click", closeModal);
  cancelBtn?.addEventListener("click", closeModal);
  modal?.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });

  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeModal();
  });

  // Manejo del Formulario (Optimistic UI)
  editForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const formData = new FormData(editForm as HTMLFormElement);
    const updates: Record<string, any> = Object.fromEntries(formData.entries());
    
    // Limpieza de datos antes de enviar
    updates.price = extractNumber(updates.price as string);
    updates.stock_quantity = extractNumber(updates.stock_quantity as string);
    
    const submitBtn = editForm.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerText = "Sincronizando...";
    }

    try {
      const response = await fetch("/api/update-product", {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(updates),
      });

      if (response.ok) {
        // 🚀 ACTUALIZACIÓN OPTIMISTA DEL DOM
        const rows = document.querySelectorAll("tr.group");
        rows.forEach(row => {
          const idSpan = row.querySelector(".font-mono") as HTMLElement | null;
          const targetId = typeof updates.id === "string" ? updates.id.split("-")[0] : "";
          if (idSpan && targetId && idSpan.innerText.includes(targetId)) {
            // Actualizar Nombre
            const nameSpan = row.querySelector(".text-sm.font-bold") as HTMLElement | null;
            if (nameSpan) nameSpan.innerText = String(updates.name ?? "");

            // Actualizar Imagen Thumbnail
            if (updates.image_url) {
              const imgEl = row.querySelector("td img") as HTMLImageElement | null;
              if (imgEl) imgEl.src = updates.image_url;
            }

            // Actualizar Precio
            const priceTd = row.querySelectorAll("td")[2] as HTMLElement | undefined;
            if (priceTd) priceTd.innerText = `$${Number(updates.price).toLocaleString("es-CO")}`;

            // Actualizar Stock
            const stockTd = row.querySelectorAll("td")[3] as HTMLElement | undefined;
            if (stockTd) stockTd.innerText = String(updates.stock_quantity ?? "");

            // Actualizar Categoría
            const categoryTd = row.querySelectorAll("td")[1] as HTMLElement | undefined;
            const categorySelect = document.getElementById("edit-category") as HTMLSelectElement | null;
            const categoryText = categorySelect && categorySelect.selectedIndex >= 0 ? categorySelect.options[categorySelect.selectedIndex]?.text || "" : "";
            
            if (categoryTd) {
              categoryTd.innerText = categoryText;
            }

            // Actualizar Estado (Badge)
            const badge = row.querySelector(".status-badge") as HTMLElement | null;
            if (badge) {
              const stock = Number(updates.stock_quantity);
              badge.className = "status-badge " + (stock > 10 ? "status-green" : stock > 0 ? "status-yellow" : "status-red");
              badge.innerText = stock > 10 ? "IN STOCK" : stock > 0 ? "LOW STOCK" : "OUT OF STOCK";
            }

            // Actualizar data-product del botón para futuras ediciones
            const editBtn = row.querySelector(".edit-product-btn");
            if (editBtn) {
              const rawData = editBtn.getAttribute("data-product");
              const currentData = rawData ? JSON.parse(rawData) : {};
              editBtn.setAttribute("data-product", JSON.stringify({
                ...currentData,
                name: updates.name,
                price: updates.price,
                stock: updates.stock_quantity,
                category_id: updates.category_id,
                category_name: categoryText,
                image_url: updates.image_url || currentData.image_url
              }));
            }
          }
        });

        closeModal();
        showToast();
      } else {
        alert("Error al actualizar el búnker. Revisa la consola.");
      }
    } catch (err) {
      console.error(err);
      alert("Error de conexión.");
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerText = "Guardar Cambios";
      }
    }
  });

  // --- LÓGICA DEL MODAL DE CREACIÓN (AÑADIR PRODUCTO) ---
  const addModal = document.getElementById("add-modal");
  const addModalContent = document.getElementById("add-modal-content");
  const addForm = document.getElementById("add-form") as HTMLFormElement | null;
  const btnAddProduct = document.getElementById("btn-add-product");
  const closeAddBtn = document.getElementById("close-add-modal");
  const cancelAddBtn = document.getElementById("cancel-add");

  const openAddModal = () => {
    addForm?.reset();
    const preview = document.getElementById("add-image-preview") as HTMLImageElement | null;
    const urlInput = document.getElementById("add-image-url") as HTMLInputElement | null;
    if (preview) preview.src = "/images/products/cerveza.png";
    if (urlInput) urlInput.value = "";
    addModal?.classList.remove("opacity-0", "pointer-events-none");
    addModalContent?.classList.remove("scale-95");
  };

  const closeAddModal = () => {
    addModal?.classList.add("opacity-0", "pointer-events-none");
    addModalContent?.classList.add("scale-95");
  };

  btnAddProduct?.addEventListener("click", openAddModal);
  closeAddBtn?.addEventListener("click", closeAddModal);
  cancelAddBtn?.addEventListener("click", closeAddModal);
  addModal?.addEventListener("click", (e) => {
    if (e.target === addModal) closeAddModal();
  });

  const addPriceInput = document.getElementById("add-price") as HTMLInputElement | null;
  addPriceInput?.addEventListener("input", (e) => {
    const target = e.target as HTMLInputElement;
    target.value = formatCOP(target.value);
  });

  // 📸 Subida de imagen en Modal Añadir
  const addImageFileInput = document.getElementById("add-image-file") as HTMLInputElement | null;
  const btnTriggerAddImage = document.getElementById("btn-trigger-add-image");
  const addImagePreview = document.getElementById("add-image-preview") as HTMLImageElement | null;
  const addImageUrl = document.getElementById("add-image-url") as HTMLInputElement | null;
  const addImageSpinner = document.getElementById("add-image-spinner");

  btnTriggerAddImage?.addEventListener("click", () => addImageFileInput?.click());

  addImageFileInput?.addEventListener("change", async () => {
    const file = addImageFileInput.files?.[0];
    if (!file) return;

    if (addImagePreview) addImagePreview.src = URL.createObjectURL(file);
    addImageSpinner?.classList.remove("hidden");

    try {
      const formData = new FormData();
      formData.append("file", file);
      const prodName = (document.getElementById("add-name") as HTMLInputElement)?.value || "nuevo_producto";
      formData.append("name", prodName);

      const res = await fetch("/api/upload-image", {
        method: "POST",
        body: formData,
      });

      const data = await res.json();
      if (res.ok && data.imageUrl) {
        if (addImageUrl) addImageUrl.value = data.imageUrl;
        if (addImagePreview) addImagePreview.src = data.imageUrl;
      } else {
        alert("Error al procesar la imagen: " + (data.error || ""));
      }
    } catch (err) {
      console.error(err);
      alert("Error de conexión al procesar la imagen.");
    } finally {
      addImageSpinner?.classList.add("hidden");
    }
  });

  // Submit de Crear Producto
  addForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const formData = new FormData(addForm);
    const newProduct: Record<string, any> = Object.fromEntries(formData.entries());

    newProduct.price = extractNumber(newProduct.price as string);
    newProduct.stock_quantity = extractNumber(newProduct.stock_quantity as string);

    const submitBtn = document.getElementById("submit-add-btn") as HTMLButtonElement | null;
    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerText = "Registrando en búnker...";
    }

    try {
      const response = await fetch("/api/create-product", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(newProduct),
      });

      const result = await response.json();
      if (response.ok) {
        closeAddModal();
        showToast();
        setTimeout(() => window.location.reload(), 800);
      } else {
        alert("Error al crear el producto: " + (result.error || ""));
      }
    } catch (err) {
      console.error(err);
      alert("Error de conexión al registrar producto.");
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerText = "Crear Producto";
      }
    }
  });
</script>
