---
export const prerender = false;

import MainLayout from "../layouts/MainLayout.astro";
import { formatCOP } from "@lib/formatters";
import { getCachedCategoriesWithProducts } from "@lib/cache";
import {
    Phone,
    Truck,
    Wine,
    Beer,
    UtensilsCrossed,
    ChevronRight,
    ShieldCheck,
    Clock,
} from "lucide-astro";

let aguardienteProducts: Array<{
    id?: string;
    name: string;
    price: number;
    formattedPrice: string;
    image_url: string;
}> = [];

try {
    const dbCategories = await getCachedCategoriesWithProducts();
    const agCategory = dbCategories.find((c) =>
        c.name.toLowerCase().includes("aguardiente")
    );
    if (agCategory && agCategory.products) {
        aguardienteProducts = agCategory.products
            .filter((p) => p.image_url)
            .map((p) => {
                const numPrice =
                    typeof p.price === "number"
                        ? p.price
                        : parseFloat(p.price as string) || 0;
                return {
                    id: p.id,
                    name: p.name,
                    price: numPrice,
                    formattedPrice: formatCOP(numPrice),
                    image_url: p.image_url as string,
                };
            });
    }
} catch (err) {
    console.error("Error al cargar productos de aguardiente para el arsenal:", err);
}

if (aguardienteProducts.length === 0) {
    aguardienteProducts = [
        {
            name: "Aguardiente Antioqueño Sin Azúcar",
            price: 45000,
            formattedPrice: "$ 45.000",
            image_url:
                "https://upload.wikimedia.org/wikipedia/commons/b/b5/Botella_de_Aguardiente_Antioque%C3%B1o.jpg",
        },
    ];
}

const firstAguardiente = aguardienteProducts[0];

const categories = [
    {
        name: "Aguardiente",
        tagline: "El alma de la rumba",
        image: "https://images.unsplash.com/photo-1516997121675-4c2d04fe116e?q=80&w=800&auto=format&fit=crop",
        icon: Wine,
        color: "teal", // Coherente con tu Admin
    },
    {
        name: "Whisky",
        tagline: "Carácter & Legado",
        image: "https://images.unsplash.com/photo-1527281405159-35d5b9a1650c?q=80&w=800&auto=format&fit=crop",
        icon: Wine,
        color: "purple",
    },
    {
        name: "Cervezas",
        tagline: "Frías como el búnker",
        image: "https://images.unsplash.com/photo-1608270586620-248524c67de9?q=80&w=800&auto=format&fit=crop",
        icon: Beer,
        color: "pink",
    },
    {
        name: "Snacks",
        tagline: "El complemento ideal",
        image: "https://images.unsplash.com/photo-1599490659213-e2b9527bb087?q=80&w=800&auto=format&fit=crop",
        icon: UtensilsCrossed,
        color: "blue",
    },
];

const featuredProducts = [
    {
        name: "Aguardiente Antioqueño Sin Azúcar",
        presentation: "750ml • 29% Vol",
        price: 45000,
        image: "https://upload.wikimedia.org/wikipedia/commons/b/b5/Botella_de_Aguardiente_Antioque%C3%B1o.jpg",
        isHot: true,
    },
    {
        name: "Johnnie Walker Black Label",
        presentation: "750ml • 12 Años",
        price: 125000,
        image: "https://upload.wikimedia.org/wikipedia/commons/2/21/Johnnie_Walker_Black_Label.jpg",
        isHot: false,
    },
    {
        name: "Club Colombia Dorada 6-Pack",
        presentation: "Lata 330ml • Edición Especial",
        price: 24000,
        image: "https://upload.wikimedia.org/wikipedia/commons/b/b7/Club_Colombia_Roja_%287143313185%29.jpg",
        isHot: false,
    },
    {
        name: "Papas Margarita Familiar",
        presentation: "110g • Sabor Natural",
        price: 8500,
        image: "https://upload.wikimedia.org/wikipedia/commons/6/6f/Lays_Classic_Potato_Chips_Bag.jpg",
        isHot: false,
    },
];
---

<MainLayout
    title="Diverpremier - Licores Premium & Domicilios en Álamos"
    description="Exclusividad en licores originales. Domicilios ultra-rápidos en Álamos Norte y Bogotá."
    containerClass="max-w-full"
    isProse={false}
>
    <section
        class="relative min-h-[95vh] flex items-center justify-center overflow-hidden px-4 mb-24 mt-4"
    >
        <div
            class="absolute inset-0 z-0 bg-dark-bg rounded-[3rem] md:rounded-[5rem] border border-white/5 mx-2 md:mx-6 overflow-hidden"
        >
            <div
                class="absolute -top-24 -right-24 w-[600px] h-[600px] bg-teal-500/10 blur-[180px] rounded-full animate-pulse"
            >
            </div>
            <div
                class="absolute -bottom-24 -left-24 w-[600px] h-[600px] bg-purple-500/10 blur-[180px] rounded-full"
            >
            </div>
            <div
                class="absolute inset-0 bg-[url('/noise.svg')] opacity-20 pointer-events-none"
            >
            </div>
        </div>

        <div class="relative z-10 text-center max-w-6xl mx-auto pt-10">
            <div
                class="inline-flex items-center gap-3 px-4 py-2 rounded-full bg-white/5 border border-white/10 text-[9px] md:text-[11px] font-black uppercase tracking-[0.5em] text-teal-400 mb-12 animate-in fade-in slide-in-from-top-4 duration-700"
            >
                <span class="relative flex h-2 w-2">
                    <span
                        class="animate-ping absolute inline-flex h-full w-full rounded-full bg-teal-400 opacity-75"
                    ></span>
                    <span
                        class="relative inline-flex rounded-full h-2 w-2 bg-teal-500"
                    ></span>
                </span>
                Búnker Operativo • Álamos Norte
            </div>

            <h1
                class="text-5xl sm:text-7xl md:text-9xl lg:text-[11rem] font-black mb-10 leading-[0.95] sm:leading-[0.9] md:leading-[0.85] lg:leading-[0.8] tracking-tighter uppercase italic text-white mix-blend-normal md:mix-blend-difference [text-shadow:0_4px_30px_rgba(0,0,0,0.8)] md:[text-shadow:none] break-words max-w-full"
            >
                Diver<wbr /><span class="text-teal-500">premier</span>
            </h1>

            <p
                class="text-lg md:text-2xl mb-14 text-neutral-400 max-w-2xl mx-auto font-medium leading-relaxed balance"
            >
                Elevamos el estándar de la rumba en <span
                    class="text-white font-bold">Álamos</span
                >. Licores de colección y domicilios de élite.
            </p>

            <div
                class="flex flex-col sm:flex-row items-center justify-center gap-8"
            >
                <a
                    href="https://wa.me/573000000000"
                    class="btn-primary px-12 py-6 text-xl shadow-[0_0_50px_rgba(20,184,166,0.2)]"
                >
                    <Phone size={24} />
                    <span>Solicitar Domicilio</span>
                </a>
                <a
                    href="/productos"
                    class="group text-neutral-500 hover:text-white font-black tracking-widest uppercase text-xs flex items-center gap-3 transition-all py-3 min-h-[44px]"
                >
                    Ver Catálogo Completo <ChevronRight
                        size={20}
                        class="group-hover:translate-x-2 transition-transform"
                    />
                </a>
            </div>
        </div>
    </section>

    <div class="max-w-7xl mx-auto px-6">
        <section class="mb-48">
            <div class="flex items-center justify-between mb-20">
                <div>
                    <h2
                        class="text-4xl md:text-6xl font-black tracking-tighter uppercase italic text-white"
                    >
                        El <span class="text-teal-500">arsenal</span>
                    </h2>
                    <p
                        class="text-neutral-500 font-mono text-[10px] uppercase tracking-widest mt-2"
                    >
                        Selección curada por expertos
                    </p>
                </div>
                <div
                    class="h-px w-24 md:w-64 bg-gradient-to-r from-teal-500/50 to-transparent hidden sm:block"
                >
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                {
                    categories.map((cat) => {
                        const isAguardiente = cat.name.toLowerCase().includes("aguardiente");

                        if (isAguardiente) {
                            return (
                                <a
                                    id="arsenal-aguardiente-card"
                                    href={`/productos?cat=${cat.name}`}
                                    class="group relative aspect-[4/5] overflow-hidden rounded-2xl sm:rounded-[3rem] border border-teal-500/40 hover:border-teal-400 transition-all duration-700 bg-neutral-950 flex flex-col justify-between p-6 sm:p-7 shadow-[0_0_35px_rgba(20,184,166,0.15)] hover:shadow-[0_0_55px_rgba(20,184,166,0.3)] block select-none"
                                >
                                    {/* Barra de progreso de 5 segundos */}
                                    <div class="absolute top-0 left-0 right-0 h-1 bg-white/5 overflow-hidden z-20">
                                        <div
                                            id="arsenal-progress-bar"
                                            class="h-full bg-gradient-to-r from-teal-500 via-teal-400 to-emerald-400 w-0"
                                        />
                                    </div>

                                    {/* Fondo cyber neón con brillo */}
                                    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-teal-950/40 via-neutral-950/80 to-neutral-950 -z-10" />
                                    <div class="absolute inset-0 bg-[url('/noise.svg')] opacity-15 pointer-events-none -z-10" />

                                    {/* Cabecera superior de la tarjeta: Badge En Vivo + Contador */}
                                    <div class="relative z-10 flex items-center justify-between w-full">
                                        <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-teal-500/15 border border-teal-500/30 text-teal-300 text-[9px] font-black uppercase tracking-widest backdrop-blur-md">
                                            <span class="relative flex h-1.5 w-1.5">
                                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-teal-400 opacity-75" />
                                                <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-teal-400" />
                                            </span>
                                            <span>En Vivo • 5s</span>
                                        </div>

                                        <span
                                            id="arsenal-product-counter"
                                            class="text-[10px] font-mono text-neutral-400 bg-white/5 px-2.5 py-1 rounded-full border border-white/10"
                                        >
                                            1 / {aguardienteProducts.length}
                                        </span>
                                    </div>

                                    {/* Botella de producto con resplandor ambiental */}
                                    <div class="relative z-10 flex-1 flex items-center justify-center my-2 overflow-hidden">
                                        <div class="absolute w-36 h-36 sm:w-44 sm:h-44 bg-teal-500/15 rounded-full blur-2xl pointer-events-none transition-all duration-700 group-hover:scale-125 group-hover:bg-teal-500/25" />
                                        <img
                                            id="arsenal-product-img"
                                            src={firstAguardiente.image_url}
                                            alt={firstAguardiente.name}
                                            width="400"
                                            height="600"
                                            loading="eager"
                                            decoding="async"
                                            class="relative z-10 max-h-[160px] sm:max-h-[190px] w-auto object-contain drop-shadow-[0_15px_30px_rgba(0,0,0,0.9)] transition-all duration-500 ease-out transform group-hover:scale-105"
                                        />
                                    </div>

                                    {/* Información inferior: Categoría, Precio, Nombre y CTA */}
                                    <div class="relative z-10 space-y-2">
                                        <div class="flex items-center justify-between">
                                            <span class="text-[10px] font-bold text-teal-400 uppercase tracking-widest">
                                                {cat.name}
                                            </span>
                                            <span
                                                id="arsenal-product-price"
                                                class="text-xs font-black text-white italic tracking-tight font-mono bg-teal-500/20 px-2 py-0.5 rounded border border-teal-500/30 transition-opacity duration-300"
                                            >
                                                {firstAguardiente.formattedPrice}
                                            </span>
                                        </div>

                                        <h3
                                            id="arsenal-product-name"
                                            class="text-base sm:text-lg font-black text-white uppercase italic tracking-tight line-clamp-2 min-h-[3rem] flex items-center transition-opacity duration-300"
                                        >
                                            {firstAguardiente.name}
                                        </h3>

                                        <div class="flex items-center justify-between pt-2 border-t border-white/5 text-[10px] font-mono text-neutral-400 group-hover:text-teal-300 transition-colors">
                                            <span>Ver arsenal ({aguardienteProducts.length})</span>
                                            <span class="group-hover:translate-x-1 transition-transform">
                                                →
                                            </span>
                                        </div>
                                    </div>
                                </a>
                            );
                        }

                        return (
                            <a
                                href={`/productos?cat=${cat.name}`}
                                class="group relative aspect-[4/5] overflow-hidden rounded-2xl sm:rounded-[3rem] border border-white/5 hover:border-teal-500/30 transition-all duration-700 bg-neutral-900"
                            >
                                <img
                                    width="800"
                                    height="1000"
                                    loading="lazy"
                                    decoding="async"
                                    src={cat.image}
                                    alt={cat.name}
                                    class="absolute inset-0 h-full w-full object-cover opacity-40 group-hover:opacity-60 transition-all duration-1000 scale-105 group-hover:scale-110"
                                />
                                <div class="absolute inset-0 bg-gradient-to-t from-dark-bg via-dark-bg/20 to-transparent" />

                                <div class="absolute inset-0 p-10 flex flex-col justify-end">
                                    <h3 class="text-4xl font-black text-white uppercase italic tracking-tighter mb-1 transform group-hover:-translate-y-2 transition-transform">
                                        {cat.name}
                                    </h3>
                                    <p class="text-[10px] font-bold text-teal-400 uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-all transform translate-y-4 group-hover:translate-y-0">
                                        {cat.tagline}
                                    </p>
                                </div>
                            </a>
                        );
                    })
                }
            </div>
        </section>

        <section
            class="grid md:grid-cols-3 gap-10 mb-48 border-y border-white/5 py-24"
        >
            <div
                class="flex flex-col items-center md:items-start text-center md:text-left space-y-6 group"
            >
                <div
                    class="w-16 h-16 bg-white/[0.03] rounded-3xl flex items-center justify-center border border-white/10 group-hover:border-teal-500/40 transition-colors"
                >
                    <Truck class="text-teal-500" size={32} />
                </div>
                <h3
                    class="text-lg font-black uppercase text-white tracking-widest"
                >
                    Entrega Flash
                </h3>
                <p class="text-neutral-500 text-sm leading-relaxed">
                    Tu pedido en la puerta de tu casa en tiempo récord. Álamos
                    es nuestro territorio.
                </p>
            </div>

            <div
                class="flex flex-col items-center md:items-start text-center md:text-left space-y-6 group"
            >
                <div
                    class="w-16 h-16 bg-white/[0.03] rounded-3xl flex items-center justify-center border border-white/10 group-hover:border-teal-500/40 transition-colors"
                >
                    <ShieldCheck class="text-teal-500" size={32} />
                </div>
                <h3
                    class="text-lg font-black uppercase text-white tracking-widest"
                >
                    100% Original
                </h3>
                <p class="text-neutral-500 text-sm leading-relaxed">
                    Sello de garantía en cada botella. Solo trabajamos con
                    distribuidores autorizados.
                </p>
            </div>

            <div
                class="flex flex-col items-center md:items-start text-center md:text-left space-y-6 group"
            >
                <div
                    class="w-16 h-16 bg-white/[0.03] rounded-3xl flex items-center justify-center border border-white/10 group-hover:border-teal-500/40 transition-colors"
                >
                    <Clock class="text-teal-500" size={32} />
                </div>
                <h3
                    class="text-lg font-black uppercase text-white tracking-widest"
                >
                    Soporte 24/7
                </h3>
                <p class="text-neutral-500 text-sm leading-relaxed">
                    ¿Dudas? Nuestro equipo VIP está listo por WhatsApp para
                    asesorar tu compra.
                </p>
            </div>
        </section>

        <section class="pb-48">
            <div
                class="flex flex-col md:flex-row md:items-end justify-between mb-20 gap-6"
            >
                <h2
                    class="text-5xl md:text-7xl font-black tracking-tighter uppercase italic text-white"
                >
                    Los <span class="text-teal-500">Favoritos</span>
                </h2>
                <p class="text-neutral-500 font-medium max-w-xs md:text-right">
                    Lo que más se mueve en las noches de Álamos.
                </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
                {
                    featuredProducts.map((prod) => (
                        <div class="group relative">
                            <div class="glass-neon rounded-2xl sm:rounded-[3rem] p-5 sm:p-8 border-white/5 hover:border-teal-500/20 transition-all duration-500 flex flex-col h-full">
                                <div class="aspect-square rounded-[2rem] overflow-hidden mb-10 bg-white/[0.03] border border-white/5 relative">
                                    {prod.isHot && (
                                        <span class="absolute top-4 left-4 z-10 px-3 py-1 rounded-full bg-teal-500 text-dark-bg text-[9px] font-black uppercase tracking-widest">
                                            Más Pedido
                                        </span>
                                    )}
                                    <img
                                        width="800"
                                        height="800"
                                        loading="lazy"
                                        decoding="async"
                                        src={prod.image}
                                        alt={prod.name}
                                        class="w-full h-full object-contain p-4 group-hover:scale-110 transition-transform duration-700"
                                    />
                                </div>

                                <h3 class="text-xl font-bold mb-2 text-white leading-tight">
                                    {prod.name}
                                </h3>
                                <p class="text-[10px] font-mono text-neutral-600 uppercase tracking-widest mb-8">
                                    {prod.presentation}
                                </p>

                                <div class="flex items-center justify-between mt-auto">
                                    <span class="text-2xl font-black text-white italic tracking-tighter">
                                        {formatCOP(prod.price)}
                                    </span>
                                    <a
                                        href="https://wa.me/573000000000"
                                        class="action-btn p-5 !rounded-2xl bg-teal-500/10 text-teal-500 hover:bg-teal-500 hover:text-dark-bg transition-all"
                                    >
                                        <Phone size={24} />
                                    </a>
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </section>
    </div>

    {/* Datos para el carrusel dinámico de aguardientes en el arsenal */}
    <script
        type="application/json"
        id="arsenal-aguardientes-json"
        set:html={JSON.stringify(aguardienteProducts)}
    />

    <script is:inline>
        (function () {
            let timer = null;

            function setupArsenalRotator() {
                if (timer) {
                    clearInterval(timer);
                    timer = null;
                }

                const dataEl = document.getElementById("arsenal-aguardientes-json");
                if (!dataEl) return;

                let products = [];
                try {
                    products = JSON.parse(dataEl.textContent || "[]");
                } catch (e) {
                    console.error("Error al parsear aguardientes:", e);
                    return;
                }

                if (!Array.isArray(products) || products.length <= 1) return;

                const imgEl = document.getElementById("arsenal-product-img");
                const nameEl = document.getElementById("arsenal-product-name");
                const priceEl = document.getElementById("arsenal-product-price");
                const counterEl = document.getElementById("arsenal-product-counter");
                const progressBar = document.getElementById("arsenal-progress-bar");
                const cardContainer = document.getElementById("arsenal-aguardiente-card");

                let currentIndex = 0;
                const total = products.length;
                const INTERVAL_MS = 5000;
                const FADE_MS = 250;

                function preload(url) {
                    if (!url) return;
                    const img = new Image();
                    img.src = url;
                }

                // Pre-cargar las siguientes imágenes en caché del navegador
                for (let i = 1; i < Math.min(6, total); i++) {
                    preload(products[i].image_url);
                }

                function resetProgressBar() {
                    if (!progressBar) return;
                    progressBar.style.transition = "none";
                    progressBar.style.width = "0%";
                    void progressBar.offsetWidth;
                    progressBar.style.transition = `width ${INTERVAL_MS}ms linear`;
                    progressBar.style.width = "100%";
                }

                function rotateProduct() {
                    currentIndex = (currentIndex + 1) % total;
                    const nextProd = products[currentIndex];

                    // Pre-cargar el siguiente por delante
                    const lookaheadIndex = (currentIndex + 1) % total;
                    preload(products[lookaheadIndex].image_url);

                    // Desvanecer suavemente
                    if (imgEl) {
                        imgEl.style.opacity = "0";
                        imgEl.style.transform = "scale(0.92) translateY(6px)";
                    }
                    if (nameEl) nameEl.style.opacity = "0";
                    if (priceEl) priceEl.style.opacity = "0";

                    setTimeout(() => {
                        if (imgEl && nextProd.image_url) {
                            imgEl.src = nextProd.image_url;
                            imgEl.alt = nextProd.name;
                        }
                        if (nameEl) {
                            nameEl.textContent = nextProd.name;
                        }
                        if (priceEl) {
                            priceEl.textContent = nextProd.formattedPrice;
                        }
                        if (counterEl) {
                            counterEl.textContent = `${currentIndex + 1} / ${total}`;
                        }

                        // Reaparecer suavemente
                        if (imgEl) {
                            imgEl.style.opacity = "1";
                            imgEl.style.transform = "scale(1) translateY(0)";
                        }
                        if (nameEl) nameEl.style.opacity = "1";
                        if (priceEl) priceEl.style.opacity = "1";

                        resetProgressBar();
                    }, FADE_MS);
                }

                resetProgressBar();
                timer = setInterval(rotateProduct, INTERVAL_MS);

                // Pausar en hover para poder leer y ver bien el producto
                if (cardContainer) {
                    cardContainer.addEventListener("mouseenter", () => {
                        if (timer) clearInterval(timer);
                        if (progressBar) {
                            const computedWidth = window.getComputedStyle(progressBar).width;
                            progressBar.style.transition = "none";
                            progressBar.style.width = computedWidth;
                        }
                    });
                    cardContainer.addEventListener("mouseleave", () => {
                        resetProgressBar();
                        if (timer) clearInterval(timer);
                        timer = setInterval(rotateProduct, INTERVAL_MS);
                    });
                }
            }

            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", setupArsenalRotator);
            } else {
                setupArsenalRotator();
            }
            document.addEventListener("astro:page-load", setupArsenalRotator);
        })();
    </script>
</MainLayout>
