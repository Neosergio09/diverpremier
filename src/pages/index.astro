---
export const prerender = false;

import MainLayout from "../layouts/MainLayout.astro";
import { formatCOP } from "@lib/formatters";
import { getCachedCategoriesWithProducts } from "@lib/cache";
import {
    Phone,
    Truck,
    ChevronRight,
    ShieldCheck,
    Clock,
} from "@lucide/astro";

interface RotatingProduct {
    id?: string;
    name: string;
    price: number;
    formattedPrice: string;
    image_url: string;
}

const categoryConfigs = [
    {
        name: "Aguardiente",
        slug: "aguardiente",
        tagline: "El alma de la rumba",
        theme: {
            border: "border-teal-500/40 hover:border-teal-400",
            shadow: "shadow-[0_0_35px_rgba(20,184,166,0.15)] hover:shadow-[0_0_55px_rgba(20,184,166,0.3)]",
            progress: "from-teal-500 via-teal-400 to-emerald-400",
            bgRadial: "from-teal-950/40 via-neutral-950/80 to-neutral-950",
            ambientGlow: "bg-teal-500/15 group-hover:bg-teal-500/25",
            badgeBg: "bg-teal-500/15 border-teal-500/30 text-teal-300",
            badgeDot: "bg-teal-400",
            priceBadge: "bg-teal-500/20 border-teal-500/30",
            categoryText: "text-teal-400",
            hoverText: "group-hover:text-teal-300",
        },
        fallback: {
            name: "Aguardiente Antioqueño Sin Azúcar",
            price: 45000,
            formattedPrice: "$ 45.000",
            image_url:
                "https://kzzpbxgsffmeyvckdmhs.supabase.co/storage/v1/object/public/diverpremier-assets/products/antioqueno_azul_botella_750ml.webp",
        },
    },
    {
        name: "Whisky",
        slug: "whisky",
        tagline: "Carácter & Legado",
        theme: {
            border: "border-amber-500/40 hover:border-amber-400",
            shadow: "shadow-[0_0_35px_rgba(245,158,11,0.15)] hover:shadow-[0_0_55px_rgba(245,158,11,0.3)]",
            progress: "from-amber-500 via-amber-400 to-yellow-300",
            bgRadial: "from-amber-950/40 via-neutral-950/80 to-neutral-950",
            ambientGlow: "bg-amber-500/15 group-hover:bg-amber-500/25",
            badgeBg: "bg-amber-500/15 border-amber-500/30 text-amber-300",
            badgeDot: "bg-amber-400",
            priceBadge: "bg-amber-500/20 border-amber-500/30",
            categoryText: "text-amber-400",
            hoverText: "group-hover:text-amber-300",
        },
        fallback: {
            name: "Buchanans Deluxe 12 Años (750ml)",
            price: 155000,
            formattedPrice: "$ 155.000",
            image_url:
                "https://kzzpbxgsffmeyvckdmhs.supabase.co/storage/v1/object/public/diverpremier-assets/products/buchanans_deluxe_12_anos_750ml.webp",
        },
    },
    {
        name: "Cervezas",
        slug: "cervezas",
        tagline: "Frías como el búnker",
        theme: {
            border: "border-rose-500/40 hover:border-rose-400",
            shadow: "shadow-[0_0_35px_rgba(244,63,94,0.15)] hover:shadow-[0_0_55px_rgba(244,63,94,0.3)]",
            progress: "from-rose-500 via-pink-400 to-orange-400",
            bgRadial: "from-rose-950/40 via-neutral-950/80 to-neutral-950",
            ambientGlow: "bg-rose-500/15 group-hover:bg-rose-500/25",
            badgeBg: "bg-rose-500/15 border-rose-500/30 text-rose-300",
            badgeDot: "bg-rose-400",
            priceBadge: "bg-rose-500/20 border-rose-500/30",
            categoryText: "text-rose-400",
            hoverText: "group-hover:text-rose-300",
        },
        fallback: {
            name: "Club Colombia Dorada Lata (330ml)",
            price: 5000,
            formattedPrice: "$ 5.000",
            image_url:
                "https://kzzpbxgsffmeyvckdmhs.supabase.co/storage/v1/object/public/diverpremier-assets/products/club_colombia_dorada_lata_330ml.webp",
        },
    },
    {
        name: "Snacks",
        slug: "snacks",
        tagline: "El complemento ideal",
        theme: {
            border: "border-sky-500/40 hover:border-sky-400",
            shadow: "shadow-[0_0_35px_rgba(14,165,233,0.15)] hover:shadow-[0_0_55px_rgba(14,165,233,0.3)]",
            progress: "from-sky-500 via-cyan-400 to-blue-400",
            bgRadial: "from-sky-950/40 via-neutral-950/80 to-neutral-950",
            ambientGlow: "bg-sky-500/15 group-hover:bg-sky-500/25",
            badgeBg: "bg-sky-500/15 border-sky-500/30 text-sky-300",
            badgeDot: "bg-sky-400",
            priceBadge: "bg-sky-500/20 border-sky-500/30",
            categoryText: "text-sky-400",
            hoverText: "group-hover:text-sky-300",
        },
        fallback: {
            name: "Papas Pringles Original (124g)",
            price: 14500,
            formattedPrice: "$ 14.500",
            image_url:
                "https://kzzpbxgsffmeyvckdmhs.supabase.co/storage/v1/object/public/diverpremier-assets/products/papas_pringles_original_124g.webp",
        },
    },
];

let categoryProductsMap: Record<string, RotatingProduct[]> = {};

try {
    const dbCategories = await getCachedCategoriesWithProducts();
    for (const conf of categoryConfigs) {
        const cat = dbCategories.find((c) =>
            c.name.toLowerCase().includes(conf.slug)
        );
        if (cat && cat.products && cat.products.length > 0) {
            categoryProductsMap[conf.slug] = cat.products
                .filter((p) => p.image_url)
                .map((p) => {
                    const numPrice =
                        typeof p.price === "number"
                            ? p.price
                            : parseFloat(p.price as string) || 0;
                    return {
                        id: p.id,
                        name: p.name,
                        price: numPrice,
                        formattedPrice: formatCOP(numPrice),
                        image_url: p.image_url as string,
                    };
                });
        }
        if (
            !categoryProductsMap[conf.slug] ||
            categoryProductsMap[conf.slug].length === 0
        ) {
            categoryProductsMap[conf.slug] = [conf.fallback];
        }
    }
} catch (err) {
    console.error("Error al cargar productos del arsenal:", err);
    for (const conf of categoryConfigs) {
        categoryProductsMap[conf.slug] = [conf.fallback];
    }
}

const featuredProducts = [
    {
        name: "Antioqueño Azul Sin Azúcar",
        presentation: "750ml • 29% Vol",
        price: 45000,
        image: "https://kzzpbxgsffmeyvckdmhs.supabase.co/storage/v1/object/public/diverpremier-assets/products/antioqueno_azul_botella_750ml.webp",
        isHot: true,
    },
    {
        name: "Johnnie Walker Black Label",
        presentation: "750ml • 12 Años",
        price: 148000,
        image: "https://kzzpbxgsffmeyvckdmhs.supabase.co/storage/v1/object/public/diverpremier-assets/products/johnnie_walker_black_label_750ml.webp",
        isHot: false,
    },
    {
        name: "Club Colombia Dorada",
        presentation: "Lata 330ml • Original",
        price: 5000,
        image: "https://kzzpbxgsffmeyvckdmhs.supabase.co/storage/v1/object/public/diverpremier-assets/products/club_colombia_dorada_lata_330ml.webp",
        isHot: false,
    },
    {
        name: "Papas Pringles Original",
        presentation: "124g • Sabor Clásico",
        price: 14500,
        image: "https://kzzpbxgsffmeyvckdmhs.supabase.co/storage/v1/object/public/diverpremier-assets/products/papas_pringles_original_124g.webp",
        isHot: false,
    },
];
---

<MainLayout
    title="Diverpremier - Licores Premium & Domicilios en Álamos"
    description="Exclusividad en licores originales. Domicilios ultra-rápidos en Álamos Norte y Bogotá."
    containerClass="max-w-full"
    isProse={false}
>
    <section
        class="relative min-h-[95vh] flex items-center justify-center overflow-hidden px-4 mb-24 mt-4"
    >
        <div
            class="absolute inset-0 z-0 bg-dark-bg rounded-[3rem] md:rounded-[5rem] border border-white/5 mx-2 md:mx-6 overflow-hidden"
        >
            <div
                class="absolute -top-24 -right-24 w-[600px] h-[600px] bg-teal-500/10 blur-[180px] rounded-full animate-pulse"
            >
            </div>
            <div
                class="absolute -bottom-24 -left-24 w-[600px] h-[600px] bg-purple-500/10 blur-[180px] rounded-full"
            >
            </div>
            <div
                class="absolute inset-0 bg-[url('/noise.svg')] opacity-20 pointer-events-none"
            >
            </div>
        </div>

        <div class="relative z-10 text-center max-w-6xl mx-auto pt-10">
            <div
                class="inline-flex items-center gap-3 px-4 py-2 rounded-full bg-white/5 border border-white/10 text-[9px] md:text-[11px] font-black uppercase tracking-[0.5em] text-teal-400 mb-12 animate-in fade-in slide-in-from-top-4 duration-700"
            >
                <span class="relative flex h-2 w-2">
                    <span
                        class="animate-ping absolute inline-flex h-full w-full rounded-full bg-teal-400 opacity-75"
                    ></span>
                    <span
                        class="relative inline-flex rounded-full h-2 w-2 bg-teal-500"
                    ></span>
                </span>
                Búnker Operativo • Álamos Norte
            </div>

            <h1
                class="text-5xl sm:text-7xl md:text-9xl lg:text-[11rem] font-black mb-10 leading-[0.95] sm:leading-[0.9] md:leading-[0.85] lg:leading-[0.8] tracking-tighter uppercase italic text-white mix-blend-normal md:mix-blend-difference [text-shadow:0_4px_30px_rgba(0,0,0,0.8)] md:[text-shadow:none] break-words max-w-full"
            >
                Diver<wbr /><span class="text-teal-500">premier</span>
            </h1>

            <p
                class="text-lg md:text-2xl mb-14 text-neutral-400 max-w-2xl mx-auto font-medium leading-relaxed balance"
            >
                Elevamos el estándar de la rumba en <span
                    class="text-white font-bold">Álamos</span
                >. Licores de colección y domicilios de élite.
            </p>

            <div
                class="flex flex-col sm:flex-row items-center justify-center gap-8"
            >
                <a
                    href="https://wa.me/573000000000"
                    class="btn-primary px-12 py-6 text-xl shadow-[0_0_50px_rgba(20,184,166,0.2)]"
                >
                    <Phone size={24} />
                    <span>Solicitar Domicilio</span>
                </a>
                <a
                    href="/productos"
                    class="group text-neutral-500 hover:text-white font-black tracking-widest uppercase text-xs flex items-center gap-3 transition-all py-3 min-h-[44px]"
                >
                    Ver Catálogo Completo <ChevronRight
                        size={20}
                        class="group-hover:translate-x-2 transition-transform"
                    />
                </a>
            </div>
        </div>
    </section>

    <div class="max-w-7xl mx-auto px-6">
        <section class="mb-48">
            <div class="flex items-center justify-between mb-20">
                <div>
                    <h2
                        class="text-4xl md:text-6xl font-black tracking-tighter uppercase italic text-white"
                    >
                        El <span class="text-teal-500">arsenal</span>
                    </h2>
                    <p
                        class="text-neutral-500 font-mono text-[10px] uppercase tracking-widest mt-2"
                    >
                        Selección curada por expertos
                    </p>
                </div>
                <div
                    class="h-px w-24 md:w-64 bg-gradient-to-r from-teal-500/50 to-transparent hidden sm:block"
                >
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                {
                    categoryConfigs.map((cat) => {
                        const prods = categoryProductsMap[cat.slug] || [cat.fallback];
                        const firstProd = prods[0];

                        return (
                            <a
                                id={`arsenal-card-${cat.slug}`}
                                href={`/productos?cat=${cat.name}`}
                                class:list={[
                                    "group relative aspect-[4/5] overflow-hidden rounded-2xl sm:rounded-[3rem] border transition-all duration-700 bg-neutral-950 flex flex-col justify-between p-6 sm:p-7 block select-none cursor-pointer",
                                    cat.theme.border,
                                    cat.theme.shadow,
                                ]}
                            >
                                {/* Barra de progreso de 5 segundos */}
                                <div class="absolute top-0 left-0 right-0 h-1 bg-white/5 overflow-hidden z-20">
                                    <div
                                        id={`arsenal-progress-${cat.slug}`}
                                        class:list={["h-full bg-gradient-to-r w-0", cat.theme.progress]}
                                    />
                                </div>

                                {/* Fondo cyber neón con brillo */}
                                <div
                                    class:list={[
                                        "absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] -z-10",
                                        cat.theme.bgRadial,
                                    ]}
                                />
                                <div class="absolute inset-0 bg-[url('/noise.svg')] opacity-15 pointer-events-none -z-10" />

                                {/* Cabecera superior de la tarjeta: Badge En Vivo + Contador */}
                                <div class="relative z-10 flex items-center justify-between w-full">
                                    <div
                                        class:list={[
                                            "inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[9px] font-black uppercase tracking-widest backdrop-blur-md border",
                                            cat.theme.badgeBg,
                                        ]}
                                    >
                                        <span class="relative flex h-1.5 w-1.5">
                                            <span
                                                class:list={[
                                                    "animate-ping absolute inline-flex h-full w-full rounded-full opacity-75",
                                                    cat.theme.badgeDot,
                                                ]}
                                            />
                                            <span
                                                class:list={[
                                                    "relative inline-flex rounded-full h-1.5 w-1.5",
                                                    cat.theme.badgeDot,
                                                ]}
                                            />
                                        </span>
                                        <span>En Vivo • 5s</span>
                                    </div>

                                    <span
                                        id={`arsenal-counter-${cat.slug}`}
                                        class="text-[10px] font-mono text-neutral-400 bg-white/5 px-2.5 py-1 rounded-full border border-white/10"
                                    >
                                        1 / {prods.length}
                                    </span>
                                </div>

                                {/* Botella/Producto con resplandor ambiental */}
                                <div class="relative z-10 flex-1 flex items-center justify-center my-2 overflow-hidden">
                                    <div
                                        class:list={[
                                            "absolute w-36 h-36 sm:w-44 sm:h-44 rounded-full blur-2xl pointer-events-none transition-all duration-700 group-hover:scale-125",
                                            cat.theme.ambientGlow,
                                        ]}
                                    />
                                    <img
                                        id={`arsenal-img-${cat.slug}`}
                                        src={firstProd.image_url}
                                        alt={firstProd.name}
                                        width="400"
                                        height="600"
                                        loading="lazy"
                                        decoding="async"
                                        class="relative z-10 max-h-[160px] sm:max-h-[190px] w-auto object-contain drop-shadow-[0_15px_30px_rgba(0,0,0,0.9)] transition-all duration-500 ease-out transform group-hover:scale-105"
                                        onerror="this.onerror=null; this.src='https://placehold.co/600x800/0A0F1E/white?text=Diverpremier';"
                                    />
                                </div>

                                {/* Información inferior: Categoría, Precio, Nombre y CTA */}
                                <div class="relative z-10 space-y-2">
                                    <div class="flex items-center justify-between">
                                        <span
                                            class:list={[
                                                "text-[10px] font-bold uppercase tracking-widest",
                                                cat.theme.categoryText,
                                            ]}
                                        >
                                            {cat.name}
                                        </span>
                                        <span
                                            id={`arsenal-price-${cat.slug}`}
                                            class:list={[
                                                "text-xs font-black text-white italic tracking-tight font-mono px-2 py-0.5 rounded border transition-opacity duration-300",
                                                cat.theme.priceBadge,
                                            ]}
                                        >
                                            {firstProd.formattedPrice}
                                        </span>
                                    </div>

                                    <h3
                                        id={`arsenal-name-${cat.slug}`}
                                        class="text-base sm:text-lg font-black text-white uppercase italic tracking-tight line-clamp-2 min-h-[3rem] flex items-center transition-opacity duration-300"
                                    >
                                        {firstProd.name}
                                    </h3>

                                    <div
                                        class:list={[
                                            "flex items-center justify-between pt-2 border-t border-white/5 text-[10px] font-mono text-neutral-400 transition-colors",
                                            cat.theme.hoverText,
                                        ]}
                                    >
                                        <span>Ver {cat.name.toLowerCase()} ({prods.length})</span>
                                        <span class="group-hover:translate-x-1 transition-transform">
                                            →
                                        </span>
                                    </div>
                                </div>
