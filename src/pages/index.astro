                        );
                    })
                }
            </div>
        </section>

        <section
            class="grid md:grid-cols-3 gap-10 mb-48 border-y border-white/5 py-24"
        >
            <div
                class="flex flex-col items-center md:items-start text-center md:text-left space-y-6 group"
            >
                <div
                    class="w-16 h-16 bg-white/[0.03] rounded-3xl flex items-center justify-center border border-white/10 group-hover:border-teal-500/40 transition-colors"
                >
                    <Truck class="text-teal-500" size={32} />
                </div>
                <h3
                    class="text-lg font-black uppercase text-white tracking-widest"
                >
                    Entrega Flash
                </h3>
                <p class="text-neutral-500 text-sm leading-relaxed">
                    Tu pedido en la puerta de tu casa en tiempo récord. Álamos
                    es nuestro territorio.
                </p>
            </div>

            <div
                class="flex flex-col items-center md:items-start text-center md:text-left space-y-6 group"
            >
                <div
                    class="w-16 h-16 bg-white/[0.03] rounded-3xl flex items-center justify-center border border-white/10 group-hover:border-teal-500/40 transition-colors"
                >
                    <ShieldCheck class="text-teal-500" size={32} />
                </div>
                <h3
                    class="text-lg font-black uppercase text-white tracking-widest"
                >
                    100% Original
                </h3>
                <p class="text-neutral-500 text-sm leading-relaxed">
                    Sello de garantía en cada botella. Solo trabajamos con
                    distribuidores autorizados.
                </p>
            </div>

            <div
                class="flex flex-col items-center md:items-start text-center md:text-left space-y-6 group"
            >
                <div
                    class="w-16 h-16 bg-white/[0.03] rounded-3xl flex items-center justify-center border border-white/10 group-hover:border-teal-500/40 transition-colors"
                >
                    <Clock class="text-teal-500" size={32} />
                </div>
                <h3
                    class="text-lg font-black uppercase text-white tracking-widest"
                >
                    Soporte 24/7
                </h3>
                <p class="text-neutral-500 text-sm leading-relaxed">
                    ¿Dudas? Nuestro equipo VIP está listo por WhatsApp para
                    asesorar tu compra.
                </p>
            </div>
        </section>

        <section class="pb-48">
            <div
                class="flex flex-col md:flex-row md:items-end justify-between mb-20 gap-6"
            >
                <h2
                    class="text-5xl md:text-7xl font-black tracking-tighter uppercase italic text-white"
                >
                    Los <span class="text-teal-500">Favoritos</span>
                </h2>
                <p class="text-neutral-500 font-medium max-w-xs md:text-right">
                    Lo que más se mueve en las noches de Álamos.
                </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
                {
                    featuredProducts.map((prod) => (
                        <div class="group relative">
                            <div class="glass-neon rounded-2xl sm:rounded-[3rem] p-5 sm:p-8 border-white/5 hover:border-teal-500/20 transition-all duration-500 flex flex-col h-full">
                                <div class="aspect-square rounded-[2rem] overflow-hidden mb-10 bg-white/[0.03] border border-white/5 relative">
                                    {prod.isHot && (
                                        <span class="absolute top-4 left-4 z-10 px-3 py-1 rounded-full bg-teal-500 text-dark-bg text-[9px] font-black uppercase tracking-widest">
                                            Más Pedido
                                        </span>
                                    )}
                                    <img
                                        width="800"
                                        height="800"
                                        loading="lazy"
                                        decoding="async"
                                        src={prod.image}
                                        alt={prod.name}
                                        class="w-full h-full object-contain p-4 group-hover:scale-110 transition-transform duration-700"
                                    />
                                </div>

                                <h3 class="text-xl font-bold mb-2 text-white leading-tight">
                                    {prod.name}
                                </h3>
                                <p class="text-[10px] font-mono text-neutral-600 uppercase tracking-widest mb-8">
                                    {prod.presentation}
                                </p>

                                <div class="flex items-center justify-between mt-auto">
                                    <span class="text-2xl font-black text-white italic tracking-tighter">
                                        {formatCOP(prod.price)}
                                    </span>
                                    <a
                                        href="https://wa.me/573000000000"
                                        class="action-btn p-5 !rounded-2xl bg-teal-500/10 text-teal-500 hover:bg-teal-500 hover:text-dark-bg transition-all"
                                    >
                                        <Phone size={24} />
                                    </a>
                                </div>
                            </div>
                        </div>
                    ))
                }
            </div>
        </section>
    </div>

    {/* Datos para el carrusel dinámico multi-categoría en el arsenal */}
    <script
        is:inline
        type="application/json"
        id="arsenal-categories-json"
        set:html={JSON.stringify(categoryProductsMap)}
    />

    <script is:inline>
        (function () {
            window._arsenalRotators = window._arsenalRotators || [];

            function cleanupArsenalRotators() {
                if (window._arsenalRotators && window._arsenalRotators.length > 0) {
                    window._arsenalRotators.forEach((rotator) => {
                        if (typeof rotator.destroy === "function") rotator.destroy();
                    });
                    window._arsenalRotators = [];
                }
            }

            function setupArsenalRotators() {
                cleanupArsenalRotators();

                const dataEl = document.getElementById("arsenal-categories-json");
                if (!dataEl) return;

                let categoriesMap = {};
                try {
                    categoriesMap = JSON.parse(dataEl.textContent || "{}");
                } catch (e) {
                    console.error("Error al parsear categorías del arsenal:", e);
                    return;
                }

                const INTERVAL_MS = 5000;
                const FADE_MS = 250;
                const STAGGER_MS = 750;

                const slugs = Object.keys(categoriesMap);

                slugs.forEach((slug, catIndex) => {
                    const products = categoriesMap[slug];
                    if (!Array.isArray(products) || products.length <= 1) return;

                    const cardEl = document.getElementById(`arsenal-card-${slug}`);
                    const imgEl = document.getElementById(`arsenal-img-${slug}`);
                    const nameEl = document.getElementById(`arsenal-name-${slug}`);
                    const priceEl = document.getElementById(`arsenal-price-${slug}`);
                    const counterEl = document.getElementById(`arsenal-counter-${slug}`);
                    const progressEl = document.getElementById(`arsenal-progress-${slug}`);

                    if (!cardEl || !imgEl) return;

                    let currentIndex = 0;
                    const total = products.length;
                    let timer = null;
                    let initialTimeout = null;
                    let isPaused = false;

                    function preload(url) {
                        if (!url) return;
                        const img = new Image();
                        img.src = url;
                    }

                    // Pre-cargar imágenes subsiguientes
                    for (let i = 1; i < Math.min(6, total); i++) {
                        preload(products[i].image_url);
                    }

                    function startProgressBar(duration) {
                        if (!progressEl) return;
                        const d = duration || INTERVAL_MS;
                        progressEl.style.transition = "none";
                        progressEl.style.width = "0%";
                        void progressEl.offsetWidth; // Forzar reflow del navegador
                        progressEl.style.transition = `width ${d}ms linear`;
                        progressEl.style.width = "100%";
                    }

                    function rotateProduct() {
                        if (isPaused) return;

                        currentIndex = (currentIndex + 1) % total;
                        const nextProd = products[currentIndex];

                        // Pre-cargar la siguiente imagen
                        const lookaheadIdx = (currentIndex + 1) % total;
                        preload(products[lookaheadIdx].image_url);

                        // Transición suave de salida
                        if (imgEl) {
                            imgEl.style.opacity = "0";
                            imgEl.style.transform = "scale(0.92) translateY(6px)";
                        }
                        if (nameEl) nameEl.style.opacity = "0";
                        if (priceEl) priceEl.style.opacity = "0";

                        setTimeout(() => {
                            if (imgEl && nextProd.image_url) {
                                imgEl.src = nextProd.image_url;
                                imgEl.alt = nextProd.name;
                            }
                            if (nameEl) {
                                nameEl.textContent = nextProd.name;
                            }
                            if (priceEl) {
                                priceEl.textContent = nextProd.formattedPrice;
                            }
                            if (counterEl) {
                                counterEl.textContent = `${currentIndex + 1} / ${total}`;
                            }

                            // Transición suave de entrada
                            if (imgEl) {
                                imgEl.style.opacity = "1";
                                imgEl.style.transform = "scale(1) translateY(0)";
                            }
                            if (nameEl) nameEl.style.opacity = "1";
                            if (priceEl) priceEl.style.opacity = "1";

                            startProgressBar(INTERVAL_MS);
                        }, FADE_MS);
                    }

                    function onMouseEnter() {
                        isPaused = true;
                        if (initialTimeout) {
                            clearTimeout(initialTimeout);
                            initialTimeout = null;
                        }
                        if (timer) {
                            clearInterval(timer);
                            timer = null;
                        }
                        if (progressEl) {
                            const computedWidth = window.getComputedStyle(progressEl).width;
                            progressEl.style.transition = "none";
                            progressEl.style.width = computedWidth;
                        }
                    }

                    function onMouseLeave() {
                        isPaused = false;
                        startProgressBar(INTERVAL_MS);
                        if (timer) clearInterval(timer);
                        timer = setInterval(rotateProduct, INTERVAL_MS);
                    }

                    cardEl.addEventListener("mouseenter", onMouseEnter);
                    cardEl.addEventListener("mouseleave", onMouseLeave);

                    // Escalonamiento inicial suave para una animación dinámica y fluida
                    const initialDelay = catIndex * STAGGER_MS;
                    startProgressBar(INTERVAL_MS + initialDelay);

                    initialTimeout = setTimeout(() => {
                        initialTimeout = null;
                        if (!isPaused) {
                            rotateProduct();
                            timer = setInterval(rotateProduct, INTERVAL_MS);
                        }
                    }, INTERVAL_MS + initialDelay);

                    window._arsenalRotators.push({
                        destroy: () => {
                            if (initialTimeout) clearTimeout(initialTimeout);
                            if (timer) clearInterval(timer);
                            cardEl.removeEventListener("mouseenter", onMouseEnter);
                            cardEl.removeEventListener("mouseleave", onMouseLeave);
                        }
                    });
                });
            }

            if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", setupArsenalRotators);
            } else {
                setupArsenalRotators();
            }
            document.addEventListener("astro:page-load", setupArsenalRotators);
        })();
    </script>
</MainLayout>
