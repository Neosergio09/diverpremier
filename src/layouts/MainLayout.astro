---
import "@styles/global.css";
import { ClientRouter } from "astro:transitions";
import Navbar from "@components/ui/Navbar.astro";
import LiquidBackground from "@components/ui/LiquidBackground.astro";
import MagicNavbar from "@components/ui/MagicNavbar.astro"; // 👈 Importamos la pieza clave
import AgeGate from "@components/ui/AgeGate.astro";
import CartDrawer from "@components/cart/CartDrawer.astro";
import Footer from "@components/ui/Footer.astro";

interface Props {
    title: string;
    description?: string;
    canonicalUrl?: string;
    ogImage?: string;
    ogType?: string;
    noindex?: boolean;
    containerClass?: string;
    isProse?: boolean;
    hideFooter?: boolean;
}

const {
    title,
    description = "Diverpremier Go - Central de Inteligencia y Logística de Licores en Álamos y Bachué, Bogotá. Domicilios de élite 24/7.",
    canonicalUrl,
    ogImage,
    ogType = "website",
    noindex = false,
    containerClass = "",
    isProse = false,
    hideFooter = false,
} = Astro.props;

// Lógica para determinar el ancho del contenedor
const widthClass = containerClass
    ? containerClass
    : isProse
      ? "max-w-3xl"
      : "max-w-7xl";

const siteUrl = (import.meta.env.PUBLIC_SITE_URL || Astro.site || "https://diverpremier.com").toString().replace(/\/$/, "");
const currentPath = Astro.url.pathname.replace(/\/$/, "");
const canonical = canonicalUrl || `${siteUrl}${currentPath || "/"}`;
const socialImage = ogImage || `${siteUrl}/images/products/whisky.png`;
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || "";

const schemaData = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "LiquorStore",
            "@id": `${siteUrl}/#organization`,
            "name": "Diverpremier Go",
            "url": siteUrl,
            "logo": `${siteUrl}/favicon.svg`,
            "image": socialImage,
            "description": description,
            "telephone": "+573114940503",
            "priceRange": "$$",
            "address": {
                "@type": "PostalAddress",
                "streetAddress": "Cl. 71B # 100-38 / Cl. 88 # 95G-15",
                "addressLocality": "Engativá",
                "addressRegion": "Bogotá",
                "postalCode": "111021",
                "addressCountry": "CO"
            },
            "geo": {
                "@type": "GeoCoordinates",
                "latitude": 4.7026601,
                "longitude": -74.1174237
            },
            "openingHoursSpecification": [
                {
                    "@type": "OpeningHoursSpecification",
                    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
                    "opens": "00:00",
                    "closes": "23:59"
                }
            ],
            "areaServed": [
                { "@type": "City", "name": "Bogotá" },
                { "@type": "AdministrativeArea", "name": "Engativá" },
                { "@type": "AdministrativeArea", "name": "Álamos Norte" },
                { "@type": "AdministrativeArea", "name": "Ciudad Bachué" }
            ],
            "sameAs": [
                "https://wa.me/573114940503"
            ]
        },
        {
            "@type": "WebSite",
            "@id": `${siteUrl}/#website`,
            "url": siteUrl,
            "name": "Diverpremier Go",
            "publisher": {
                "@id": `${siteUrl}/#organization`
            }
        }
    ]
};
---

<!doctype html>
<html lang="es" class="bg-dark-bg transition-colors duration-500">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />

        <title>{title} | Diverpremier Go</title>
        <meta name="description" content={description} />

        <!-- Canonical URL -->
        <link rel="canonical" href={canonical} />

        <!-- Directivas para Rastreadores e Indexación (Googlebot) -->
        <meta
            name="robots"
            content={noindex
                ? "noindex, nofollow"
                : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
        />
        <meta
            name="googlebot"
            content={noindex
                ? "noindex, nofollow"
                : "index, follow, max-snippet:-1, max-image-preview:large"}
        />

        <!-- Verificación de Google Search Console (Meta tag) -->
        {googleSiteVerification && (
            <meta name="google-site-verification" content={googleSiteVerification} />
        )}

        <!-- Open Graph / Facebook -->
        <meta property="og:site_name" content="Diverpremier Go" />
        <meta property="og:type" content={ogType} />
        <meta property="og:url" content={canonical} />
        <meta property="og:title" content={`${title} | Diverpremier Go`} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={socialImage} />
        <meta property="og:locale" content="es_CO" />

        <!-- Twitter Cards -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={canonical} />
        <meta name="twitter:title" content={`${title} | Diverpremier Go`} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={socialImage} />

        <!-- Datos Estructurados JSON-LD (Schema.org) para Google Rich Results -->
        <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

        <ClientRouter />
        <slot name="head" />

        <!-- Theme Initialization Script -->
        <script is:inline>
            (function () {
                try {
                    const savedTheme = localStorage.getItem("theme");
                    const isSystemLight = window.matchMedia(
                        "(prefers-color-scheme: light)",
                    ).matches;
                    if (
                        savedTheme === "light" ||
                        (!savedTheme && isSystemLight)
                    ) {
                        document.documentElement.classList.add("light");
                    }
                } catch (e) {}
            })();
        </script>
    </head>
    <body
        class="selection:bg-neon-pink selection:text-white antialiased text-body-color min-h-screen bg-transparent overflow-x-hidden relative transition-colors duration-500"
    >
        <LiquidBackground />

        <AgeGate />

        <CartDrawer />

        <Navbar />

        <main
            class:list={[
                "mx-auto pt-20 sm:pt-32 pb-24 sm:pb-28 md:pb-48 px-3.5 sm:px-6 relative z-10",
                widthClass,
                { "prose prose-invert lg:prose-xl prose-neon": isProse },
            ]}
        >
            <slot />
        </main>

        <MagicNavbar />

        <slot name="page-footer" />

        { !hideFooter && <Footer /> }

        <style is:global>
            @reference "@styles/global.css";

            html {
                scroll-behavior: smooth;
            }

            body {
                margin: 0;
            }

            /* 🖋️ Refinamiento de la Letra Capital */
            .prose p:first-of-type::first-letter {
                @apply float-left text-7xl font-black mr-4 mt-2 text-neon-blue leading-[0.7];
                text-shadow: 0 0 20px rgba(56, 189, 248, 0.4);
            }

            /* Estilos de Tipografía para modo oscuro */
            .prose-neon {
                --tw-prose-body: theme("colors.slate.300");
                --tw-prose-headings: theme("colors.white");
                --tw-prose-links: var(--color-neon-blue);
                --tw-prose-bold: theme("colors.white");
            }
        </style>
    </body>
</html>
